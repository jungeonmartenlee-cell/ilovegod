---
import { brand, namesLine } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: '홈' },
  { href: '/qt', label: '큐티' },
  { href: '/about', label: '소개' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header>
  <div class="container bar">
    <a href="/" class="logo" aria-label={`${brand} 홈`}>
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.2 0 3.7 1.2 5.3 3.1 1.6-1.9 3.1-3.1 5.3-3.1 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/>
      </svg>
      <span class="words">
        <span class="brand">{brand}</span>
        {namesLine && namesLine !== brand && <span class="dept">{namesLine}</span>}
      </span>
    </a>
    <nav aria-label="주요 메뉴">
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 8px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    text-decoration: none;
  }
  .mark { flex: none; width: 22px; height: 22px; fill: var(--warm); }
  .words { display: flex; flex-direction: column; min-width: 0; line-height: 1.2; }
  .brand {
    font-weight: 800;
    font-size: 1.02rem;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .dept { font-size: .66rem; font-weight: 700; letter-spacing: .14em; color: var(--muted); white-space: nowrap; }
  nav { display: flex; gap: 2px; }
  nav { flex: none; }
  nav a {
    padding: 8px 11px;
    border-radius: 999px;
    font-size: .92rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-soft);
  }
</style>
