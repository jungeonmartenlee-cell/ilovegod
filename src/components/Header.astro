---
import { BRAND } from '../config';
import type { CommunityEntry } from '../communities';

interface Props { community?: CommunityEntry }
const { community } = Astro.props;
const home = '/'; // 로고를 누르면 공동체 고르는 첫 화면으로
---
<header>
  <div class="container bar">
    <a href={home} class="logo" aria-label={`${BRAND} 홈`}>
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.2 0 3.7 1.2 5.3 3.1 1.6-1.9 3.1-3.1 5.3-3.1 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/>
      </svg>
      <span class="words">
        <span class="brand">{BRAND}</span>
        {community?.namesLine && <span class="names">{community.namesLine}</span>}
      </span>
    </a>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
  }
  .bar { display: flex; align-items: center; height: 54px; }
  .logo { display: flex; align-items: center; gap: 9px; text-decoration: none; min-width: 0; }
  .mark { flex: none; width: 20px; height: 20px; fill: var(--heart); }
  .words { display: flex; flex-direction: column; line-height: 1.15; min-width: 0; }
  .brand { font-weight: 700; font-size: 1rem; letter-spacing: -0.035em; word-spacing: .1em; white-space: nowrap; }
  .names { font-size: .62rem; font-weight: 600; letter-spacing: .16em; color: var(--muted); white-space: nowrap; }
</style>
