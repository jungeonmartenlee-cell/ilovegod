---
import { shortDate, type Qt } from '../lib/qt';
interface Props { qt: Qt }
const { qt } = Astro.props;
---
<a class="item" href={`/qt/${qt.id}`}>
  <span class="date">{shortDate(qt.data.date)}</span>
  <span class="body">
    <span class="title">{qt.data.title}</span>
    <span class="meta">{qt.data.passage} · {qt.data.preacher}</span>
  </span>
  <span class="arrow" aria-hidden="true">›</span>
</a>

<style>
  .item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .date {
    flex: none;
    width: 52px;
    font-weight: 800;
    font-size: .95rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .title { font-weight: 700; line-height: 1.45; }
  .meta { font-size: .85rem; color: var(--muted); }
  .arrow { color: var(--muted); font-size: 1.4rem; }
</style>
