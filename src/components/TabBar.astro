---
// 화면 아래에 떠 있는 유리 탭 바 (공동체 페이지에서만)
import type { CommunityEntry } from '../communities';

interface Props { community: CommunityEntry }
const { community } = Astro.props;
const base = `/${community.slug}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const tabs = [
  { href: base, label: '홈', icon: 'M11.3 2.6a1.1 1.1 0 0 1 1.4 0l8.4 6.9c.3.2.4.5.4.9V20a1.5 1.5 0 0 1-1.5 1.5H15a.8.8 0 0 1-.8-.8v-5.2a.8.8 0 0 0-.8-.8h-2.8a.8.8 0 0 0-.8.8v5.2a.8.8 0 0 1-.8.8H4a1.5 1.5 0 0 1-1.5-1.5v-9.6c0-.4.1-.7.4-.9z' },
  { href: `${base}/gbs`, label: 'GBS', icon: 'M2.5 5.2c0-.5.3-.9.8-1.1C6 3 8.9 3.1 11.3 4.6v15.6c-2.6-1.4-5.4-1.5-8-.4a.6.6 0 0 1-.8-.6zM12.7 4.6C15.1 3.1 18 3 20.7 4.1c.5.2.8.6.8 1.1v13.6a.6.6 0 0 1-.8.6c-2.6-1.1-5.4-1-8 .4z' },
  { href: `${base}/about`, label: '소개', icon: 'M9 11.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm8.3.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zM1.5 19.2C2 15.6 5.1 13.3 9 13.3s7 2.3 7.5 5.9c.1.7-.4 1.3-1.1 1.3H2.6c-.7 0-1.2-.6-1.1-1.3zm16.4 1.3c.2-.4.2-.9.1-1.4-.3-2-1.3-3.7-2.8-4.9.6-.2 1.3-.3 2.1-.3 3 0 5.4 1.8 5.8 4.6.1.6-.3 1.2-1 1.2z' },
];
const active = (href: string) => (href === base ? path === base : path.startsWith(href));
---
<nav class="tabbar" aria-label="메뉴">
  {tabs.map((t) => (
    <a href={t.href} aria-current={active(t.href) ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.icon} /></svg>
      <span>{t.label}</span>
    </a>
  ))}
</nav>

<style>
  .tabbar {
    position: fixed;
    left: 50%;
    bottom: calc(12px + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 30;
    display: flex;
    gap: 0;
    padding: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(20px) saturate(190%);
    backdrop-filter: blur(20px) saturate(190%);
    border: 0.5px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 0.5px 0 rgba(255,255,255,.9) inset, 0 8px 28px rgba(0, 0, 0, 0.12);
  }
  @media (prefers-color-scheme: dark) {
    .tabbar { background: rgba(30, 30, 32, 0.72); border-color: rgba(255,255,255,.1); box-shadow: 0 8px 28px rgba(0,0,0,.5); }
  }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    width: 84px;
    padding: 8px 0 7px;
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    font-size: .7rem;
    font-weight: 500;
  }
  svg { width: 25px; height: 25px; fill: currentColor; }
  a[aria-current='page'] { color: var(--accent); background: rgba(118, 118, 128, 0.12); font-weight: 600; }
</style>
