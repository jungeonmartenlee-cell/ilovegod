---
import { CONTACT, BRAND } from '../config';
import { namesLine } from '../lib/site';
---
<footer>
  <div class="container">
    <p class="names">{namesLine}</p>
    {(CONTACT.instagram || CONTACT.kakao) && (
      <p class="links">
        {CONTACT.instagram && <a href={`https://instagram.com/${CONTACT.instagram}`}>인스타그램</a>}
        {CONTACT.kakao && <a href={CONTACT.kakao}>카카오톡</a>}
      </p>
    )}
    {BRAND && <p class="brand">♡ {BRAND}</p>}
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 24px 0 calc(32px + env(safe-area-inset-bottom));
    font-size: .85rem;
    color: var(--muted);
  }
  p { margin: 0 0 4px; }
  .names { font-weight: 700; letter-spacing: .12em; }
  .brand { margin-top: 14px; font-size: .8rem; font-weight: 600; color: var(--warm); letter-spacing: .02em; }
  .links { display: flex; gap: 14px; margin-top: 8px; }
</style>
