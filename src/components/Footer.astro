---
import { BRAND } from '../config';
import type { CommunityEntry } from '../communities';

interface Props { community?: CommunityEntry }
const { community } = Astro.props;
const contact = community?.contact ?? {};
---
<footer>
  <div class="container">
    {community && <p class="names">{community.namesLine}</p>}
    {(contact.instagram || contact.kakao) && (
      <p class="links">
        {contact.instagram && <a href={`https://instagram.com/${contact.instagram}`}>Instagram</a>}
        {contact.kakao && <a href={contact.kakao}>카카오톡</a>}
      </p>
    )}
    <div class="brand-row">
      <p class="brand"><a href="/">{BRAND}</a></p>
      <p class="legal"><a href="/terms">이용약관</a><span>·</span><a href="/privacy">개인정보 처리방침</a></p>
    </div>
  </div>
</footer>

<style>
  footer { padding: 8px 0 calc(28px + var(--tabbar) + env(safe-area-inset-bottom)); font-size: .78rem; color: var(--faint); }
  .container { border-top: 0.5px solid var(--line); padding-top: 20px; }
  p { margin: 0 0 4px; }
  .names { font-weight: 600; letter-spacing: .14em; }
  .links { display: flex; gap: 14px; }
  .links a { color: var(--muted); }
  .brand a { text-decoration: none; }
  .brand-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .brand-row p { margin: 0; }
  .legal { font-size: .72rem; opacity: .8; white-space: nowrap; }
  .legal a { color: inherit; text-decoration: none; }
  .legal span { margin: 0 5px; }
</style>
