---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TabBar from '../components/TabBar.astro';
import Gates from '../components/Gates.astro';
import { BRAND, MAIN } from '../config';
import type { CommunityEntry } from '../communities';

interface Props {
  title?: string;
  description?: string;
  community?: CommunityEntry;
  /** 탭 바·바닥글 없이 화면 전체를 쓰는 페이지 (나눔방) */
  bare?: boolean;
  /** 위쪽 로고 머리글 숨기기 (자체 상단 바를 쓰는 화면) */
  hideHeader?: boolean;
}
const { title, community, bare = false, hideHeader = false } = Astro.props;
const description = Astro.props.description
  ?? community?.description
  ?? (community ? `${community.mainName} 소개와 주일 설교 후 소그룹 GBS 나눔 자료` : MAIN.description);
const brand = BRAND;
const where = community ? community.mainName : '';
const fullTitle = title
  ? `${title} | ${where ? `${where} · ` : ''}${brand}`
  : community ? `${community.namesLine} · ${brand}` : brand;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- 카카오톡·문자로 링크 공유할 때 보이는 미리보기 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <slot name="head" />
    <style is:global>body.has-tabbar { --tabbar: 84px; }</style>
  </head>
  <body class:list={[{ 'has-tabbar': community && !bare, bare }]}>
    {!hideHeader && <Header community={community} />}
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    {!bare && <Footer community={community} />}
    {community && !bare && <TabBar community={community} />}
    <Gates />
  </body>
</html>
