---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TabBar from '../components/TabBar.astro';
import Gates from '../components/Gates.astro';
import Intro from '../components/Intro.astro';
import { BRAND, MAIN } from '../config';
import type { CommunityEntry } from '../communities';

interface Props {
  title?: string;
  description?: string;
  community?: CommunityEntry;
  /** 탭 바·바닥글 없이 화면 전체를 쓰는 페이지 (나눔방) */
  bare?: boolean;
  /** 위쪽 로고 머리글 숨기기 (자체 상단 바를 쓰는 화면) */
  hideHeader?: boolean;
  /** 이 화면만의 시작 애니메이션 문구 (교역자 화면 등) */
  intro?: { line1: string; line2: string; id: string };
}
const { title, community, bare = false, hideHeader = false, intro } = Astro.props;
const description = Astro.props.description
  ?? community?.description
  ?? (community ? `${community.mainName} 소개와 주일 설교 후 소그룹 GBS 나눔 자료` : MAIN.description);
const brand = BRAND;
const where = community ? community.mainName : '';
const fullTitle = title
  ? `${title} | ${where ? `${where} · ` : ''}${brand}`
  : community ? `${community.namesLine} · ${brand}` : brand;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f2f2f7" />
    <!-- 화면이 그려지기 전에 라이트/다크를 정해서 깜빡이지 않게 -->
    <script is:inline>
      (function () {
        // 고른 모드 저장 — 브라우저가 저장을 막아도 같은 창 안에서는 유지되도록 여러 곳에 남겨요
        function read() {
          try { var v = localStorage.getItem('theme'); if (v) return v; } catch (e) {}
          try { var w = sessionStorage.getItem('theme'); if (w) return w; } catch (e) {}
          var m = /(?:^|; )theme=(light|dark)/.exec(document.cookie || '');
          if (m) return m[1];
          var n = /(?:^|;)theme:(light|dark)/.exec(window.name || '');
          return n ? n[1] : null;
        }
        function save(t) {
          try { localStorage.setItem('theme', t); } catch (e) {}
          try { sessionStorage.setItem('theme', t); } catch (e) {}
          try { document.cookie = 'theme=' + t + '; path=/; max-age=31536000; samesite=lax'; } catch (e) {}
          window.name = (window.name || '').replace(/(^|;)theme:(light|dark)/g, '') + ';theme:' + t;
        }
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function apply(t) {
          document.documentElement.dataset.theme = t;
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'dark' ? '#000000' : '#f2f2f7');
        }
        apply(read() || (mq.matches ? 'dark' : 'light'));
        if (mq.addEventListener) mq.addEventListener('change', function (e) { if (!read()) apply(e.matches ? 'dark' : 'light'); });
        window.__setTheme = function (t) { save(t); apply(t); };
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- 카카오톡·문자로 링크 공유할 때 보이는 미리보기 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <slot name="head" />
    <style is:global>body.has-tabbar { --tabbar: 84px; }</style>
  </head>
  <body class:list={[{ 'has-tabbar': community && !bare, bare }]}>
    {intro ? <Intro {...intro} /> : !bare && <Intro />}
    {!hideHeader && <Header community={community} />}
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    {!bare && <Footer community={community} />}
    {community && !bare && <TabBar community={community} />}
    <Gates />
  </body>
</html>
