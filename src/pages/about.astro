---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, WORSHIP, ABOUT } from '../config';
import { eulReul } from '../lib/qt';

// 이 페이지의 문구는 src/config.ts 의 ABOUT 에서 바꿔요.
const { vision, people, meetings, welcome } = ABOUT;
---
<BaseLayout title="부서 소개" description={`${SITE.name} 비전, 섬기는 사람들, 모임 안내`}>
  <span class="eyebrow">ABOUT</span>
  <h1>{eulReul(SITE.name)} 소개합니다</h1>
  <p class="muted lead">{SITE.intro} {SITE.attendance}</p>

  <h2 class="section-title">비전</h2>
  <blockquote class="verse">
    <p>{vision.verse}</p>
    <cite>{vision.ref}</cite>
  </blockquote>
  <ul class="points">
    {vision.points.map((p, i) => (
      <li class="card">
        <span class="num">0{i + 1}</span>
        <div><strong>{p.title}</strong><p class="muted">{p.text}</p></div>
      </li>
    ))}
  </ul>

  <h2 class="section-title">섬기는 사람들</h2>
  <ul class="people">
    {people.map((p) => (
      <li class="card">
        <span class="role">{p.role}</span>
        <strong>{p.name}</strong>
        <span class="muted note">{p.note}</span>
      </li>
    ))}
  </ul>

  <h2 class="section-title">모임 안내</h2>
  <ul class="meetings">
    {meetings.map((m) => (
      <li><strong>{m.name}</strong><p class="muted">{m.desc}</p></li>
    ))}
  </ul>

  <h2 class="section-title">시간 · 장소</h2>
  <div class="card times">
    {WORSHIP.map((w) => (
      <p><span class="role">{w.label}</span><br /><strong>{w.time}</strong> · {w.place}</p>
    ))}
  </div>

  <div class="card welcome">
    <strong>{welcome.title}</strong>
    <p class="muted">{welcome.text}</p>
  </div>
</BaseLayout>

<style>
  .lead { margin: 0; }
  .verse {
    margin: 0 0 14px;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--warm-soft);
  }
  .verse p { margin: 0; font-weight: 600; line-height: 1.75; }
  .verse cite { display: block; margin-top: 8px; font-style: normal; font-size: .88rem; color: var(--warm); font-weight: 700; }

  ul { list-style: none; margin: 0; padding: 0; }
  .points { display: grid; gap: 10px; }
  .points li { display: flex; gap: 14px; padding: 18px; }
  .num { flex: none; font-weight: 800; color: var(--accent); font-size: 1.05rem; }
  .points p { margin: 2px 0 0; font-size: .93rem; line-height: 1.6; }

  .people { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .people li { display: flex; flex-direction: column; padding: 16px; }
  .role { font-size: .78rem; font-weight: 700; color: var(--warm); }
  .note { font-size: .85rem; }

  .meetings li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .meetings p { margin: 2px 0 0; font-size: .93rem; line-height: 1.6; }

  .times p { margin: 0 0 12px; }
  .times p:last-child { margin: 0; }
  .welcome { margin-top: 28px; background: var(--accent-soft); border-color: transparent; box-shadow: none; }
  .welcome p { margin: 4px 0 0; font-size: .93rem; }
</style>
