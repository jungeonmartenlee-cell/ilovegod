---
// 교역자 검수 — 주소: /staff
// 로그인 → 검수할 나눔지 고르기 → 요약 · 나눔 · 묵상 · 기도 확인 → 보낼 공동체 → 승인하고 배포
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { approvalId, gbsSlug, formatDate } from '../../lib/gbs';
import { communities } from '../../communities';

const all = (await getCollection('gbs', (g) => !g.data.draft && gbsSlug(g) !== ''))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const folderOf = (id: string) => id.split('/')[0];
const items = all.map((g) => {
  const targets = folderOf(g.id) === 'shared' ? (g.data.communities ?? []) : [folderOf(g.id), ...(g.data.communities ?? [])];
  return {
    id: approvalId(g), slug: gbsSlug(g), review: g.data.status === 'review', targets,
    title: g.data.title, passage: g.data.passage, preacher: g.data.preacher, date: formatDate(g.data.date),
    service: g.data.service ?? '', key: g.data.key, summary: g.data.summary,
    questions: g.data.share.questions, practice: g.data.share.practice ?? '',
    devotions: g.data.devotions.map((v) => ({ day: v.day, ref: v.ref, title: v.title, question: v.question })),
    prayers: g.data.prayers, songs: g.data.songs,
    // 교역자 화면에서 고칠 수 있는 나눔지 (shared 폴더) — 고칠 때 쓰는 전체 내용
    file: folderOf(g.id) === 'shared' ? gbsSlug(g) : '',
    full: folderOf(g.id) === 'shared' ? {
      title: g.data.title, passage: g.data.passage, preacher: g.data.preacher, service: g.data.service ?? '',
      date: g.data.date.toISOString().slice(0, 10), key: g.data.key, summary: g.data.summary, verses: g.data.verses,
      word: g.data.word ? { original: g.data.word.original ?? '', word: g.data.word.word, meaning: g.data.word.meaning } : null,
      flow: g.data.flow.map((f) => ({ title: f.title, note: f.note ?? '' })),
      share: { minutes: g.data.share.minutes ?? 40, questions: g.data.share.questions, practice: g.data.share.practice ?? '' },
      devotions: g.data.devotions.map((v) => ({ ref: v.ref, title: v.title, body: v.body, question: v.question })),
      prayers: g.data.prayers, songs: g.data.songs,
    } : null,
  };
});
const names = Object.fromEntries(communities.map((c) => [c.slug, c.mainName]));
const info = Object.fromEntries(communities.map((c) => [c.slug, { name: c.mainName, tagline: c.tagline ?? '', intro: c.intro ?? '', worship: (c.worship ?? []).map((w) => ({ label: w.label, time: w.time, place: w.place })) }]));
---
<BaseLayout title="교역자" bare intro={{ lead: '1분', line1: '설교 원고에서 나눔지까지', line2: '', id: 'intro-staff' }}>
  <script type="application/json" id="staff-data" set:html={JSON.stringify({ items, names, info })} />
  <div class="staff">
    <header class="topbar">
      <button type="button" class="icon-btn" data-back aria-label="뒤로" hidden><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg></button>
      <span class="topbar-title" data-title></span>
      <span></span>
    </header>
    <div class="progress" data-progress hidden><span></span></div>
    <main data-view></main>
    <div class="cta" data-cta></div>
  </div>
</BaseLayout>

<script>
  import { GoogleAuthProvider, signInWithPopup, signInWithCredential, signOut, onAuthStateChanged, type User } from 'firebase/auth';
  import { doc, getDoc, setDoc, deleteDoc, addDoc, updateDoc, collection, getDocs, query, where, serverTimestamp, onSnapshot } from 'firebase/firestore';
  import { auth, db } from '../../lib/firebase';
  import { loadApprovals } from '../../lib/approval';
  import { makeGbs, submitGbs, createCommunity, saveCommunity, updateGbs, deleteGbs, aiError, type MadeGbs } from '../../lib/ai';

  type Item = {
    id: string; slug: string; review: boolean; targets: string[]; title: string; passage: string; preacher: string;
    date: string; service: string; key: string; summary: string[]; questions: { tag: string; text: string }[];
    practice: string; devotions: { day: string; ref: string; title: string; question: string }[];
    prayers: string[]; songs: string[]; file: string; full: MadeGbs | null;
  };
  type Info = { name: string; tagline: string; intro: string; worship: { label: string; time: string; place: string }[] };
  const { items, names, info } = JSON.parse(document.getElementById('staff-data')!.textContent!) as { items: Item[]; names: Record<string, string>; info: Record<string, Info> };
  const fresh = new Set<string>();     // 방금 만든 공동체 (사이트에 나타나기까지 1~2분)
  const view = document.querySelector<HTMLElement>('[data-view]')!;
  const cta = document.querySelector<HTMLElement>('[data-cta]')!;
  const titleEl = document.querySelector<HTMLElement>('[data-title]')!;
  const backBtn = document.querySelector<HTMLButtonElement>('[data-back]')!;
  const progress = document.querySelector<HTMLElement>('[data-progress]')!;
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  /** 받침에 따라 을/를 (예: 준비를, 사랑을) */
  const eul = (w: string) => {
    const c = w.charCodeAt(w.length - 1) - 0xac00;
    return c < 0 || c > 11171 ? `${w}을(를)` : `${w}${c % 28 ? '을' : '를'}`;
  };
  const params = new URLSearchParams(location.search);
  const emu = params.has('emulator') ? '?emulator=1' : '';

  let user: User | null = null;
  let mine: string[] = [];            // 내가 맡은 공동체
  let isAdmin = false;                // 공동체 개설 신청을 확인하는 운영자
  let approvals: Record<string, string[]> = {};
  let back: (() => void) | null = null;
  let onList = false;                 // 첫 화면(목록)을 보고 있는지
  let registered = false;            // staff 문서가 있는지 (승인된 교역자)
  let approvalTitles: Record<string, string> = {};   // 배포 기록의 나눔지 제목
  let pendingStaff = 0;               // 운영자: 기다리는 교역자 등록 신청 수

  let onMaking = false;               // '만들고 있어요' 화면을 보고 있는지
  type Draft = { id: string; status: 'making' | 'ready' | 'failed'; gbs?: MadeGbs; communities: string[]; error?: string; at?: any };
  let drafts: Draft[] = [];

  function frame(opts: { title?: string; step?: [number, number]; body: string; primary?: [string, () => void]; secondary?: [string, () => void]; back?: () => void }) {
    onList = false; onMaking = false;
    titleEl.textContent = opts.title ?? '';
    back = opts.back ?? null; backBtn.hidden = !back;
    document.querySelector<HTMLElement>('.staff .topbar')!.hidden = !back && !opts.title;
    progress.hidden = !opts.step;
    if (opts.step) progress.querySelector('span')!.style.width = `${(opts.step[0] / opts.step[1]) * 100}%`;
    view.innerHTML = `<section class="screen">${opts.body}</section>`;
    cta.innerHTML = '';
    if (opts.primary) {
      const b = document.createElement('button'); b.className = 'btn big'; b.textContent = opts.primary[0]; b.onclick = opts.primary[1]; cta.append(b);
    }
    if (opts.secondary) {
      const b = document.createElement('button'); b.className = 'text-btn'; b.textContent = opts.secondary[0]; b.onclick = opts.secondary[1]; cta.append(b);
    }
    scrollTo(0, 0);
  }
  backBtn.onclick = () => back?.();
  const toast = (msg: string) => {
    let t = document.querySelector<HTMLElement>('.toast');
    if (!t) { t = document.createElement('div'); t.className = 'toast'; document.body.append(t); }
    t.textContent = msg; t.classList.add('on');
    clearTimeout((t as any)._h); (t as any)._h = setTimeout(() => t!.classList.remove('on'), 2200);
  };
  const busy = async (fn: () => Promise<void>) => {
    const b = cta.querySelector<HTMLButtonElement>('.btn'); if (b) { b.disabled = true; b.textContent = '처리 중…'; }
    try { await fn(); } catch (e) { console.error(e); toast('처리하지 못했어요. 권한이나 인터넷 연결을 확인해 주세요.'); if (b) b.disabled = false; }
  };

  // ── 1. 로그인
  function loginScreen() {
    frame({
      body: `<h1 class="big-title">교역자</h1>
        <p class="lead">설교 원고를 올리면 스밈이 1분 만에 나눔지를 만들어요.<br />확인하고 맡은 공동체에 배포하면 끝이에요.</p>
        <div class="note">처음이시면 구글 계정으로 시작해 등록 신청을 해 주세요. 운영자가 승인하면 바로 쓸 수 있어요.</div>
        <p class="lead small center" style="margin-top:18px"><a href="/guide" class="inline-link">처음이신가요? 1분 안내 보기</a></p>`,
      primary: ['구글 계정으로 시작하기', () => busy(login)],
    });
  }
  async function login() {
    const testEmail = params.get('as');
    if (emu && testEmail) {
      await signInWithCredential(auth, GoogleAuthProvider.credential(JSON.stringify({ sub: testEmail, email: testEmail, email_verified: true })));
    } else {
      await signInWithPopup(auth, new GoogleAuthProvider());
    }
  }

  // ── 2. 목록
  const status = (it: Item) => {
    const out = approvals[it.id] ?? [];
    if (!it.review) return { label: '바로 공개 자료', on: true };
    return out.length ? { label: `배포됨 · ${out.map((c) => names[c] ?? c).join(', ')}`, on: true } : { label: '배포 전', on: false };
  };
  function listScreen() {
    const mineItems = items.filter((it) => it.review && it.targets.some((t) => mine.includes(t)));
    // 방금 배포해서 아직 사이트에 반영되지 않은 나눔지 (1~2분)
    const freshItems = Object.keys(approvals).filter((id) => !items.some((it) => it.id === id) && (approvals[id] ?? []).some((c) => mine.includes(c)));
    const waiting = mineItems.filter((it) => !(approvals[it.id] ?? []).length).length;
    frame({
      title: '',
      body: `<p class="eyebrow">${esc(user!.email!)}</p>
        ${mine.length ? `<h1 class="big-title">${waiting ? `배포 전 나눔지가<br />${waiting}개 있어요` : '모두 배포했어요'}</h1>
        <p class="lead">맡은 공동체: ${mine.map((c) => esc(names[c] ?? c)).join(', ')} <button type="button" class="inline-link" data-mine-qr>공동체 QR</button></p>` : `<h1 class="big-title">환영해요!<br />이렇게 시작해 보세요</h1>
        <ol class="start-steps">
          <li><b>1</b><span><strong>설교 원고로 나눔지 만들기</strong><small>원고만 올리면 스밈이 1분 안팎으로 만들어요</small></span></li>
          <li><b>2</b><span><strong>검토하고 고치기</strong><small>요약·질문·묵상·기도를 한 화면씩 확인해요</small></span></li>
          <li><b>3</b><span><strong>공동체에 배포하고 QR 전달</strong><small>공동체가 없으면 이름만 적어 바로 만들어요</small></span></li>
        </ol>`}
        ${draftsHtml()}
        ${mine.length ? `<p class="section-label">우리 공동체 나눔지</p>` : ''}
        <ul class="rows">${freshItems.map((id) => `<li class="item-card">
            <span class="txt"><strong>${esc(approvalTitles[id] ?? '새 나눔지')}</strong><span>배포됨 · ${(approvals[id] ?? []).map((c) => esc(names[c] ?? c)).join(', ')} · 1~2분 뒤 공동체 화면에 나타나요</span></span>
            <div class="chips"><button type="button" class="chip pull" data-pull-fresh="${id}">거둬들이기</button>
              <button type="button" class="chip" data-del="${id.replace(/^shared__/, '')}" data-del-title="${esc(approvalTitles[id] ?? '')}">지우기</button></div></li>`).join('')}
          ${mineItems.map((it) => {
          const s = status(it);
          const pullable = (approvals[it.id] ?? []).some((c) => mine.includes(c));
          return `<li class="item-card">
            <button type="button" class="item-open" data-open="${it.id}">
              <span class="txt"><strong>${esc(it.title)}</strong><span>${esc(it.passage)} · ${esc(it.date)}</span><span class="st ${s.on ? 'on' : ''}">${esc(s.label)}</span></span>
            </button>
            <div class="chips">
              <button type="button" class="chip" data-open="${it.id}">검토하기</button>
              ${it.full ? `<button type="button" class="chip" data-edit-gbs="${it.id}">수정하기</button>` : ''}
              ${pullable ? `<button type="button" class="chip pull" data-pull="${it.id}">거둬들이기</button>` : `<button type="button" class="chip on" data-open="${it.id}">배포하기</button>`}
              ${it.file ? `<button type="button" class="chip" data-del="${it.file}" data-del-title="${esc(it.title)}">지우기</button>` : ''}
            </div></li>`;
        }).join('') || (mine.length && !freshItems.length ? '<li class="empty">아직 나눔지가 없어요</li>' : '')}</ul>
        <ul class="menu">
          <li><button type="button" data-qr><span>QR 내려받기</span>${'<svg viewBox="0 0 8 13"><path d="M1.5 1.5 6.5 6.5 1.5 11.5"/></svg>'}</button></li>
          <li><button type="button" data-new-community><span>새 공동체 만들기</span>${'<svg viewBox="0 0 8 13"><path d="M1.5 1.5 6.5 6.5 1.5 11.5"/></svg>'}</button></li>
          ${mine.length ? `<li><button type="button" data-edit-community><span>공동체 소개 고치기</span>${'<svg viewBox="0 0 8 13"><path d="M1.5 1.5 6.5 6.5 1.5 11.5"/></svg>'}</button></li>` : ''}
        </ul>
        ${isAdmin ? `<div class="admin-zone">
          <p class="admin-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3M5 10h14v11H5z" /></svg>운영자 전용 · 운영자에게만 보여요</p>
          <ul class="menu admin">
            <li><button type="button" data-staff-admin><span>교역자 관리${pendingStaff ? ` <b class="badge">${pendingStaff}</b>` : ''}</span>${'<svg viewBox="0 0 8 13"><path d="M1.5 1.5 6.5 6.5 1.5 11.5"/></svg>'}</button></li>
          </ul></div>` : ''}`,
      primary: ['설교 원고로 나눔지 만들기', () => sermonStep(0, { communities: [...mine] })],
      secondary: ['로그아웃', () => signOut(auth)],
    });
    view.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => (b.onclick = () => review(items.find((i) => i.id === b.dataset.open)!, 0)));
    view.querySelectorAll<HTMLElement>('[data-pull]').forEach((b) => (b.onclick = () => pullScreen(items.find((i) => i.id === b.dataset.pull)!)));
    view.querySelectorAll<HTMLElement>('[data-edit-gbs]').forEach((b) => (b.onclick = () => {
      const it = items.find((i) => i.id === b.dataset.editGbs)!;
      editDraft({ gbs: { ...it.full! }, editFile: it.file, communities: it.targets }, 0);
    }));
    view.querySelectorAll<HTMLElement>('[data-del]').forEach((b) => (b.onclick = () => deleteScreen(b.dataset.del!, b.dataset.delTitle || '이 나눔지')));
    view.querySelectorAll<HTMLElement>('[data-pull-fresh]').forEach((b) => (b.onclick = () => {
      const id = b.dataset.pullFresh!;
      pullScreen({ id, title: approvalTitles[id] ?? '이 나눔지' } as Item);
    }));
    view.querySelector<HTMLElement>('[data-new-community]')!.onclick = () => createScreen();
    const ed = view.querySelector<HTMLElement>('[data-edit-community]'); if (ed) ed.onclick = chooseEdit;
    view.querySelector<HTMLElement>('[data-qr]')!.onclick = qrScreen;
    const sa = view.querySelector<HTMLElement>('[data-staff-admin]'); if (sa) sa.onclick = staffAdminScreen;
    const mq = view.querySelector<HTMLElement>('[data-mine-qr]'); if (mq) mq.onclick = () => qrPopup(mine);
    bindDrafts();
    onList = true;
  }

  // ── 스밈이 만든 나눔지 (만드는 중 · 다 만듦 · 실패) — 첫 화면 맨 위에 보여요
  const ago = (d: Draft) => { const m = Math.max(0, Math.round((Date.now() - (d.at?.toMillis?.() ?? Date.now())) / 60000)); return m < 1 ? '방금' : `${m}분 전`; };
  const stuck = (d: Draft) => d.status === 'making' && Date.now() - (d.at?.toMillis?.() ?? Date.now()) > 12 * 60000;
  function draftsHtml() {
    if (!drafts.length) return '';
    return `<p class="section-label">스밈이 만든 나눔지</p><ul class="rows">${drafts.map((d) => {
      const t = d.gbs?.title ? esc(d.gbs.title) : '새 나눔지';
      if (d.status === 'ready') return `<li class="item-card draft ready"><button type="button" class="item-open" data-draft="${d.id}">
          <span class="txt"><strong>${t}</strong><span>${esc(d.gbs?.passage ?? '')} · 다 만들었어요</span></span></button>
          <div class="chips"><button type="button" class="chip on" data-draft="${d.id}">검토하고 배포하기</button><button type="button" class="chip" data-drop="${d.id}">지우기</button></div></li>`;
      if (d.status === 'failed' || stuck(d)) return `<li class="item-card draft"><span class="txt"><strong>만들지 못했어요</strong><span>${esc(d.error ?? '원고를 다시 올려 주세요.')}</span></span>
          <div class="chips"><button type="button" class="chip" data-drop="${d.id}">지우기</button></div></li>`;
      return `<li class="item-card draft"><span class="txt"><strong><span class="dot"></span>스밈이 만들고 있어요</strong><span>${ago(d)} 시작 · 다 되면 여기서 확인할 수 있어요</span></span></li>`;
    }).join('')}</ul>`;
  }
  function bindDrafts() {
    view.querySelectorAll<HTMLElement>('[data-draft]').forEach((b) => (b.onclick = () => {
      const d = drafts.find((x) => x.id === b.dataset.draft); if (!d?.gbs) return;
      const gbs = { ...d.gbs }; if (!gbs.date) gbs.date = today();
      confirmSermon({ communities: d.communities, gbs, draftId: d.id });
    }));
    view.querySelectorAll<HTMLElement>('[data-drop]').forEach((b) => (b.onclick = async () => {
      try { await deleteDoc(doc(db, 'drafts', b.dataset.drop!)); toast('지웠어요'); } catch { toast('지우지 못했어요'); }
    }));
  }
  function watchDrafts() {
    const known = new Map<string, string>();
    let first = true;
    onSnapshot(query(collection(db, 'drafts'), where('by', '==', user!.email)), (snap) => {
      drafts = snap.docs.map((x) => ({ id: x.id, ...(x.data() as any) }))
        .sort((a, b) => (b.at?.toMillis?.() ?? Date.now()) - (a.at?.toMillis?.() ?? Date.now()));
      for (const d of drafts) {
        if (!first && d.status === 'ready' && known.get(d.id) !== 'ready' && !onMaking) madeNotice(d);
        known.set(d.id, d.status);
      }
      first = false;
      if (onList) listScreen();
    }, () => {});
  }
  // 다 만들었을 때 알려 주기 — 화면 안내 + (허락한 경우) 기기 알림
  function madeNotice(d: Draft) {
    const title = d.gbs?.title ?? '나눔지';
    toast(`스밈이 「${title}」 나눔지를 다 만들었어요`);
    try { navigator.vibrate?.(200); } catch {}
    try {
      if ('Notification' in window && Notification.permission === 'granted' && document.visibilityState !== 'visible')
        new Notification('스밈이 나눔지를 다 만들었어요', { body: `「${title}」 · 눌러서 확인하고 올려 주세요`, icon: '/favicon.svg' });
    } catch {}
    if (document.visibilityState !== 'visible') {
      const old = document.title; document.title = '✓ 나눔지 완성 · ' + old;
      document.addEventListener('visibilitychange', () => (document.title = old), { once: true });
    }
  }
  const canNotify = () => 'Notification' in window && Notification.permission === 'default';

  // ── QR 내려받기 — 공동체 광고 시간에 PPT로 띄우거나 주보에 넣어요
  function qrScreen() {
    const site = (import.meta.env.SITE as string | undefined)?.replace(/\/$/, '') || location.origin;
    const link = (c: string) => `${site}/${c}`;
    const rows: [string, string, string | undefined][] = [
      ['', '하나님을 사랑합니다', undefined],
      ...mine.map((c) => [c, names[c] ?? c, (c.match(/[a-z0-9]/i)?.[0] ?? '').toUpperCase()] as [string, string, string]),
    ];
    frame({
      title: 'QR 내려받기', back: listScreen,
      body: `<h1 class="big-title">QR 내려받기</h1>
        <p class="lead">QR 가운데에 공동체 첫 글자(예: GIL → G)가, 메인 QR에는 하트가 들어가요. 저장한 이미지 위에는 이름도 크게 들어가니 PPT나 주보에 그대로 넣어 주세요.</p>
        <ul class="rows">${rows.map(([c, title], i) => `<li class="item-card">
          <span class="txt"><strong>${esc(title)}</strong><span>${esc(link(c).replace(/^https?:\/\//, '').replace(/\/$/, ''))}${c ? '' : ' · 메인 화면'}</span></span>
          <div class="chips"><button type="button" class="chip on" data-save-qr="${i}">QR 저장</button>
            <button type="button" class="chip" data-copy-link="${c}">링크 복사</button></div></li>`).join('')}</ul>`,
    });
    view.querySelectorAll<HTMLElement>('[data-save-qr]').forEach((b) => (b.onclick = async () => {
      const [c, title, label] = rows[Number(b.dataset.saveQr)];
      const { saveQrPoster } = await import('../../lib/qr-art');
      await saveQrPoster(link(c), title, label);
    }));
    view.querySelectorAll<HTMLElement>('[data-copy-link]').forEach((b) => (b.onclick = async () => {
      try { await navigator.clipboard.writeText(link(b.dataset.copyLink!)); toast('링크를 복사했어요'); } catch { toast('복사가 안 되는 환경이에요'); }
    }));
  }

  // ── 교역자 등록 신청 — 등록되지 않은 구글 계정이면 신청을 받고, 운영자가 승인하면 쓸 수 있어요
  type Signup = { name?: string; phone?: string; communities?: string[] };
  const phoneFmt = (v: string) => {
    const d = v.replace(/\D/g, '').slice(0, 11);
    return d.length < 4 ? d : d.length < 8 ? `${d.slice(0, 3)}-${d.slice(3)}` : `${d.slice(0, 3)}-${d.slice(3, d.length - 4)}-${d.slice(-4)}`;
  };
  async function signupStart() {
    frame({ body: '<p class="lead center" style="margin-top:40vh">불러오는 중…</p>' });
    try {
      const r = await getDoc(doc(db, 'staffRequests', user!.email!));
      if (r.exists()) return signupPending(r.data() as Signup);
    } catch {}
    signupStep(0, {});
  }
  function signupStep(step: number, d: Signup) {
    const go = (n: number, patch: Signup = {}) => signupStep(n, { ...d, ...patch });
    const common = { title: '교역자 등록 신청', step: [step + 1, 4] as [number, number], back: step ? () => go(step - 1) : () => signOut(auth) };
    if (step === 0) {
      frame({ ...common, body: `<h2 class="screen-title">처음 오셨네요</h2>
        <p class="lead">교역자로 등록되지 않은 계정이에요. 등록 신청을 하면 운영자가 확인한 뒤 승인해 드려요.</p>
        <div class="kvs"><div class="kv"><span>구글 계정</span><strong>${esc(user!.email ?? '')}</strong></div></div>
        <p class="lead small">다른 계정으로 쓰시려면 아래 '다른 계정으로 로그인'을 눌러 주세요.</p>`,
        primary: ['등록 신청하기', () => go(1)], secondary: ['다른 계정으로 로그인', () => signOut(auth)] });
    }
    if (step === 1) {
      frame({ ...common, body: `<h2 class="screen-title">이름을 알려 주세요</h2><p class="lead">실명과 함께 <b>목사·전도사 등 직책</b>까지 적어 주시면 운영자가 확인하는 데 도움이 돼요.</p>
        <input class="field one" maxlength="20" placeholder="예: 홍길동 목사, 김하나 전도사" value="${esc(d.name ?? '')}" /><p class="field-error" hidden></p>`,
        primary: ['다음', () => { const v = view.querySelector<HTMLInputElement>('.field')!.value.trim(); if (!v) return fieldError('이름을 적어 주세요'); go(2, { name: v }); }] });
    }
    if (step === 2) {
      frame({ ...common, body: `<h2 class="screen-title">전화번호를 알려 주세요</h2><p class="lead">본인 확인에만 쓰고, 승인하거나 반려하면 바로 지워요.</p>
        <input class="field one" type="tel" inputmode="numeric" maxlength="13" placeholder="010-1234-5678" value="${esc(d.phone ?? '')}" /><p class="field-error" hidden></p>`,
        primary: ['다음', () => {
          const v = phoneFmt(view.querySelector<HTMLInputElement>('.field')!.value);
          if (v.replace(/\D/g, '').length < 9) return fieldError('전화번호를 확인해 주세요');
          go(3, { phone: v });
        }] });
      const f = view.querySelector<HTMLInputElement>('.field')!;
      f.oninput = () => (f.value = phoneFmt(f.value));
    }
    if (step === 3) {
      const all = Object.keys(names);
      frame({ ...common, body: `<h2 class="screen-title">어느 공동체를 섬기시나요?</h2><p class="lead">이미 있는 공동체라면 골라 주세요. 새로 시작하는 공동체라면 고르지 않고 신청한 뒤, 승인되면 <b>새 공동체 개설 신청</b>에서 만들 수 있어요.</p>
        <ul class="checks">${all.map((c) => `<li><label><input type="checkbox" value="${c}" ${(d.communities ?? []).includes(c) ? 'checked' : ''} /><span>${esc(names[c] ?? c)}</span></label></li>`).join('')}</ul>`,
        primary: ['신청하기', () => busy(async () => {
          const communities = Array.from(view.querySelectorAll<HTMLInputElement>('input:checked')).map((i) => i.value);
          const data = { email: user!.email!, name: d.name!, phone: d.phone!, communities, at: serverTimestamp() };
          await setDoc(doc(db, 'staffRequests', user!.email!), data);
          signupPending({ ...data });
        })] });
    }
  }
  function signupPending(d: Signup) {
    frame({
      body: `<div class="done-mark"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
        <h1 class="big-title center">등록 신청을 받았어요</h1>
        <p class="lead center">운영자가 승인하면 이용하실 수 있어요.<br />승인되면 이 화면을 새로 고쳐 주세요.</p>
        <div class="kvs"><div class="kv"><span>이름</span><strong>${esc(d.name ?? '')}</strong></div>
          <div class="kv"><span>구글 계정</span><strong>${esc(user!.email ?? '')}</strong></div>
          ${d.communities?.length ? `<div class="kv"><span>공동체</span><strong>${d.communities.map((c) => esc(names[c] ?? c)).join(', ')}</strong></div>` : ''}</div>`,
      primary: ['새로 고치기', () => location.reload()],
      secondary: ['신청 내용 고치기', () => signupStep(1, d)],
    });
  }

  // ── 운영자: 교역자 등록 신청 확인 · 교역자 목록
  async function staffAdminScreen() {
    frame({ title: '교역자 관리', back: listScreen, body: '<p class="lead center">불러오는 중…</p>' });
    let reqs: any[] = [], staff: any[] = [];
    try {
      reqs = (await getDocs(collection(db, 'staffRequests'))).docs.map((x) => ({ id: x.id, ...(x.data() as any) }))
        .sort((a, b) => (a.at?.toMillis?.() ?? 0) - (b.at?.toMillis?.() ?? 0));
      staff = (await getDocs(collection(db, 'staff'))).docs.map((x) => ({ id: x.id, ...(x.data() as any) }));
    } catch { toast('불러오지 못했어요. 규칙(권한)을 확인해 주세요'); }
    const cn = (cs: string[] = []) => cs.map((c) => esc(names[c] ?? c)).join(', ') || '공동체 미정';
    frame({
      title: '교역자 관리', back: listScreen,
      body: `<h1 class="big-title">${reqs.length ? `등록 신청이<br />${reqs.length}건 있어요` : '새 등록 신청이 없어요'}</h1>
        <ul class="rows">${reqs.map((r) => `<li class="item-card">
          <span class="txt"><strong>${esc(r.name)}</strong><span>${esc(r.phone)} · ${esc(r.id)}</span><span>${cn(r.communities)}</span></span>
          <div class="chips"><button type="button" class="chip on" data-approve="${esc(r.id)}">승인</button>
            <button type="button" class="chip" data-reject="${esc(r.id)}">반려</button></div></li>`).join('')}</ul>
        <p class="section-label">교역자 ${staff.length}명</p>
        <ul class="rows">${staff.map((t) => `<li class="item-card">
          <span class="txt"><strong>${esc(t.name ?? t.id)}${t.admin ? ' · 운영자' : ''}</strong>${t.name ? `<span>${esc(t.id)}</span>` : ''}<span>${cn(t.communities)}</span></span>
          ${t.admin ? '' : `<div class="chips"><button type="button" class="chip" data-edit-staff="${esc(t.id)}">공동체 바꾸기</button><button type="button" class="chip" data-remove="${esc(t.id)}">권한 해제</button></div>`}</li>`).join('')}</ul>`,
    });
    view.querySelectorAll<HTMLElement>('[data-approve]').forEach((b) => (b.onclick = () => assignScreen(reqs.find((r) => r.id === b.dataset.approve), true)));
    view.querySelectorAll<HTMLElement>('[data-edit-staff]').forEach((b) => (b.onclick = () => { const t = staff.find((x) => x.id === b.dataset.editStaff); assignScreen({ id: t.id, name: t.name ?? t.id, communities: t.communities }, false); }));
    view.querySelectorAll<HTMLElement>('[data-reject]').forEach((b) => (b.onclick = async () => {
      const r = reqs.find((x) => x.id === b.dataset.reject);
      if (!confirm(`${r.name} 님의 신청을 반려할까요? 신청 내용(전화번호 포함)은 지워져요.`)) return;
      try { await deleteDoc(doc(db, 'staffRequests', r.id)); toast('반려했어요'); staffAdminScreen(); } catch { toast('처리하지 못했어요'); }
    }));
    view.querySelectorAll<HTMLElement>('[data-remove]').forEach((b) => (b.onclick = async () => {
      const t = staff.find((x) => x.id === b.dataset.remove);
      if (!confirm(`${t.name ?? t.id} 님의 교역자 권한을 해제할까요?`)) return;
      try { await deleteDoc(doc(db, 'staff', t.id)); toast('권한을 해제했어요'); staffAdminScreen(); } catch { toast('처리하지 못했어요'); }
    }));
  }
  // 맡길 공동체를 고르고 승인(또는 바꾸기)
  function assignScreen(r: { id: string; name: string; communities?: string[] }, isNew: boolean) {
    const all = Object.keys(names);
    frame({
      title: isNew ? '승인하기' : '공동체 바꾸기', back: staffAdminScreen,
      body: `<h2 class="screen-title">${esc(r.name)} 님이<br />맡을 공동체를 골라 주세요</h2><p class="lead">${esc(r.id)}<br />새 공동체를 직접 개설할 분이라면 고르지 않고 승인해도 돼요.</p>
        <ul class="checks">${all.map((c) => `<li><label><input type="checkbox" value="${c}" ${(r.communities ?? []).includes(c) ? 'checked' : ''} /><span>${esc(names[c] ?? c)}</span></label></li>`).join('')}</ul>
        <p class="field-error" hidden></p>`,
      primary: [isNew ? '승인하기' : '저장하기', () => {
        const picked = Array.from(view.querySelectorAll<HTMLInputElement>('input:checked')).map((i) => i.value);
        busy(async () => {
          await setDoc(doc(db, 'staff', r.id), { communities: picked, name: r.name.slice(0, 20) });
          if (isNew) await deleteDoc(doc(db, 'staffRequests', r.id));   // 전화번호가 담긴 신청서는 지워요
          toast(isNew ? `${r.name} 님을 승인했어요` : '저장했어요');
          staffAdminScreen();
        });
      }],
    });
  }

  // ── 새 공동체 만들기 — 이름만 적으면 끝 (주소는 스밈이 정해요)
  function createScreen(after: () => void = listScreen) {
    frame({ title: '새 공동체 만들기', back: after,
      body: `<h2 class="screen-title">공동체 이름을 적어 주세요</h2>
        <p class="lead">이름만 적으면 바로 만들어져요. 소개와 예배 시간은 나중에 언제든 고칠 수 있어요.</p>
        <input class="field one" maxlength="20" placeholder="예: 하손내빚" /><p class="field-error" hidden></p>`,
      primary: ['만들기', () => {
        const name = view.querySelector<HTMLInputElement>('.field')!.value.trim().replace(/\s+/g, ' ');
        if (!name) return fieldError('공동체 이름을 적어 주세요');
        busy(async () => {
          let r: { slug: string; name: string };
          try { r = await createCommunity(name); }
          catch (e) { toast(aiError(e, '만들지 못했어요. 다시 해 주세요.')); const b = cta.querySelector<HTMLButtonElement>('.btn'); if (b) { b.disabled = false; b.textContent = '만들기'; } return; }
          if (!mine.includes(r.slug)) mine = [...mine, r.slug];
          const ready = drafts.filter((x) => x.status === 'ready' && x.gbs);
          names[r.slug] = r.name; info[r.slug] = { name: r.name, tagline: '', intro: '', worship: [] }; fresh.add(r.slug);
          frame({
            body: `<div class="done-mark"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
              <h1 class="big-title center">「${esc(r.name)}」<br />공동체를 만들었어요</h1>
              <p class="lead center">1~2분 뒤 사이트에 나타나요.</p>
              <div class="share-qr-row"><button type="button" class="qr-cta" data-deploy-new>
                <svg class="line" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>
                <span><strong>${ready.length ? '나눔지 배포하기' : '나눔지 만들기'}</strong><small>${ready.length ? `만든 나눔지 「${esc(ready[0].gbs?.title ?? '')}」${eul(ready[0].gbs?.title ?? '').slice((ready[0].gbs?.title ?? '').length)} 이 공동체에 올려요` : '설교 원고만 올리면 1분이면 돼요'}</small></span></button></div>
              <div class="share-qr-row tight"><button type="button" class="qr-cta" data-edit-new>
                <svg class="line" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4" /></svg>
                <span><strong>공동체 소개 채우기</strong><small>한 줄 소개, 예배 시간·장소를 적어 주세요</small></span></button></div>`,
            primary: ['첫 화면으로', listScreen],
          });
          view.querySelector<HTMLElement>('[data-edit-new]')!.onclick = () => editScreen(r.slug);
          view.querySelector<HTMLElement>('[data-deploy-new]')!.onclick = () => {
            const d = ready[0];
            if (!d?.gbs) return sermonStep(0, { communities: [r.slug] });
            const gbs = { ...d.gbs }; if (!gbs.date) gbs.date = today();
            deployDraft({ communities: [r.slug], gbs, draftId: d.id });
          };
        });
      }] });
    view.querySelector<HTMLInputElement>('.field')!.focus();
  }

  // ── 공동체 소개 고치기
  function chooseEdit() {
    if (mine.length === 1) return editScreen(mine[0]);
    frame({ title: '공동체 소개 고치기', back: listScreen, body: `<h2 class="screen-title">어느 공동체를 고칠까요?</h2>
      <ul class="menu">${mine.map((c) => `<li><button type="button" data-c="${c}"><span>${esc(names[c] ?? c)}</span>${'<svg viewBox="0 0 8 13"><path d="M1.5 1.5 6.5 6.5 1.5 11.5"/></svg>'}</button></li>`).join('')}</ul>` });
    view.querySelectorAll<HTMLElement>('[data-c]').forEach((b) => (b.onclick = () => editScreen(b.dataset.c!)));
  }
  function editScreen(slug: string) {
    const c = info[slug] ?? { name: names[slug] ?? slug, tagline: '', intro: '', worship: [] };
    const rows = c.worship.length ? c.worship : [{ label: '', time: '', place: '' }];
    const row = (w: { label: string; time: string; place: string }) => `<div class="w-row">
        <input class="field" data-w="label" maxlength="20" placeholder="예: 주일예배" value="${esc(w.label)}" />
        <input class="field" data-w="time" maxlength="40" placeholder="예: 주일 15:40" value="${esc(w.time)}" />
        <input class="field" data-w="place" maxlength="60" placeholder="예: 제1교육관 5층" value="${esc(w.place)}" /></div>`;
    frame({ title: '공동체 소개 고치기', back: listScreen,
      body: `<h2 class="screen-title">${esc(c.name)}</h2><p class="lead">비워 둔 칸은 사이트에서 보이지 않아요.</p>
        <label class="ed"><span>공동체 이름</span><input class="field" data-k="name" maxlength="20" value="${esc(c.name)}" /></label>
        <label class="ed"><span>한 줄 소개</span><input class="field" data-k="tagline" maxlength="60" placeholder="예: God Is Love" value="${esc(c.tagline)}" /></label>
        <label class="ed"><span>소개 글</span><textarea class="memo field" data-k="intro" maxlength="400" placeholder="공동체를 짧게 소개해 주세요">${esc(c.intro)}</textarea></label>
        <div class="ed"><span>예배·모임</span><div data-rows>${rows.map(row).join('')}</div>
          <button type="button" class="text-btn add-row" data-add>+ 예배·모임 더하기</button></div>
        <p class="field-error" hidden></p>`,
      primary: ['저장하기', () => {
        const v = (k: string) => view.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!.value.trim();
        if (!v('name')) return fieldError('공동체 이름을 적어 주세요');
        const worship = Array.from(view.querySelectorAll<HTMLElement>('.w-row')).map((r) => ({
          label: r.querySelector<HTMLInputElement>('[data-w="label"]')!.value.trim(),
          time: r.querySelector<HTMLInputElement>('[data-w="time"]')!.value.trim(),
          place: r.querySelector<HTMLInputElement>('[data-w="place"]')!.value.trim(),
        })).filter((w) => w.label || w.time || w.place);
        const edit = { name: v('name'), tagline: v('tagline'), intro: v('intro'), worship };
        busy(async () => {
          try { await saveCommunity(slug, edit); }
          catch (e) { toast(aiError(e, '저장하지 못했어요. 다시 해 주세요.')); const b = cta.querySelector<HTMLButtonElement>('.btn'); if (b) { b.disabled = false; b.textContent = '저장하기'; } return; }
          info[slug] = edit; names[slug] = edit.name;
          toast('저장했어요. 1~2분 뒤 사이트에 반영돼요');
          listScreen();
        });
      }] });
    view.querySelector<HTMLElement>('[data-add]')!.onclick = () => {
      if (view.querySelectorAll('.w-row').length >= 6) return;
      view.querySelector<HTMLElement>('[data-rows]')!.insertAdjacentHTML('beforeend', row({ label: '', time: '', place: '' }));
    };
  }

  // ── 공동체 QR 팝업 — 공동체를 연 뒤, 나눔지를 배포한 뒤 바로 QR을 받아 전달할 수 있어요
  const SITE = (import.meta.env.SITE as string | undefined)?.replace(/\/$/, '') || location.origin;
  const initialOf = (c: string) => (c.match(/[a-z0-9]/i)?.[0] ?? '').toUpperCase();
  async function qrPopup(slugs: string[]) {
    const list = slugs.filter((c) => names[c]);
    if (!list.length) return toast('아직 열리지 않은 공동체예요. 공동체가 열리면 QR을 받을 수 있어요');
    const { qrSvg, saveQrPoster } = await import('../../lib/qr-art');
    const dlg = document.createElement('div');
    dlg.className = 'dialog-backdrop';
    dlg.innerHTML = `<div class="dialog qr-pop" role="dialog" aria-modal="true" aria-label="공동체 QR">
        <button type="button" class="qr-x" data-x aria-label="닫기"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
        ${list.map((c) => `<section>
          <h2>${esc(names[c])}</h2>
          <div class="qr-box">${qrSvg(`${SITE}/${c}`, initialOf(c))}</div>
          <p>${esc(`${SITE}/${c}`.replace(/^https?:\/\//, ''))}</p>
          <button type="button" class="btn" data-save="${c}">QR 저장하기</button>
          <button type="button" class="text-btn" data-link="${c}">링크 복사</button></section>`).join('')}
      </div>`;
    document.body.append(dlg);
    requestAnimationFrame(() => dlg.classList.add('on'));
    const close = () => { dlg.classList.remove('on'); setTimeout(() => dlg.remove(), 200); };
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.querySelector<HTMLElement>('[data-x]')!.onclick = close;
    dlg.querySelectorAll<HTMLElement>('[data-save]').forEach((b) => (b.onclick = () => {
      const c = b.dataset.save!; saveQrPoster(`${SITE}/${c}`, names[c], initialOf(c));
    }));
    dlg.querySelectorAll<HTMLElement>('[data-link]').forEach((b) => (b.onclick = async () => {
      try { await navigator.clipboard.writeText(`${SITE}/${b.dataset.link}`); toast('링크를 복사했어요'); } catch { toast('복사가 안 되는 환경이에요'); }
    }));
  }

  // ── 거둬들이기 (배포 중지) — 작은 확인 창
  function pullScreen(it: Item, after: () => void = listScreen) {
    const targets = (approvals[it.id] ?? []).filter((c) => mine.includes(c));
    const where = targets.map((c) => names[c] ?? c).join(', ');
    const dlg = document.createElement('div');
    dlg.className = 'dialog-backdrop';
    dlg.innerHTML = `<div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="dlg-t">
        <h2 id="dlg-t">${esc(eul(it.title))} ${esc(where)}에서<br />거둬들일까요?</h2>
        <p>공동체 화면에서 바로 사라져요.<br />언제든 다시 배포할 수 있어요.</p>
        <div class="dialog-actions">
          <button type="button" class="dlg-cancel">취소</button>
          <button type="button" class="dlg-ok">거둬들이기</button>
        </div></div>`;
    document.body.append(dlg);
    requestAnimationFrame(() => dlg.classList.add('on'));
    const close = () => { dlg.classList.remove('on'); setTimeout(() => dlg.remove(), 200); };
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.querySelector<HTMLButtonElement>('.dlg-cancel')!.onclick = close;
    const ok = dlg.querySelector<HTMLButtonElement>('.dlg-ok')!;
    ok.onclick = async () => {
      ok.disabled = true; ok.textContent = '처리 중…';
      try {
        for (const c of targets) await deleteDoc(doc(db, 'approvals', `${it.id}~${c}`));
        approvals = await loadApprovals();
        close(); toast(`${where}에서 거둬들였어요`); after();
      } catch { ok.disabled = false; ok.textContent = '거둬들이기'; toast('처리하지 못했어요. 권한이나 인터넷 연결을 확인해 주세요.'); }
    };
  }

  // ── 설교 원고 올리기 — 원고만 넣으면 스밈(AI)이 나눔지를 만들어요 (원고는 저장하지 않아요)
  type Sermon = { text?: string; fileName?: string; pdf?: string; communities?: string[]; note?: string; gbs?: MadeGbs; draftId?: string; editFile?: string };
  const SERVICES = ['주일예배', '새벽예배', '수요예배', '금요기도회'];
  const today = () => { const d = new Date(Date.now() + 9 * 3600_000); return d.toISOString().slice(0, 10); };
  const SSTEPS = 4;
  let makeRun = 0;                    // 만드는 중에 뒤로 가면 이전 결과는 버려요
  function fieldError(msg: string) { const e = view.querySelector<HTMLElement>('.field-error')!; e.textContent = msg; e.hidden = false; }
  function sermonStep(step: number, d: Sermon) {
    const go = (n: number, patch: Sermon = {}) => sermonStep(n, { ...d, ...patch });
    const common = { title: '설교 원고 올리기', step: [step + 1, SSTEPS] as [number, number], back: step ? () => go(step === 3 ? 0 : step - 1) : listScreen };
    if (step === 0) {
      frame({ ...common, body: `<h2 class="screen-title">설교 원고를 넣어 주세요</h2>
        <p class="lead">원고만 넣으면 스밈(AI)이 설교자와 예배를 찾아 적고 나눔지를 만들어요.</p>
        <label class="file-btn"><input type="file" accept=".pdf,.docx,.txt,application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document" hidden />
          <span>PDF·워드 파일 불러오기</span></label>
        <p class="file-name" ${d.fileName ? '' : 'hidden'}>${esc(d.fileName ?? '')}${d.pdf ? ' · PDF를 그대로 스밈에게 보내요' : ''}</p>
        <textarea class="memo field big" maxlength="60000" placeholder="여기에 원고를 붙여 넣어 주세요">${esc(d.text ?? '')}</textarea>
        <p class="count"><span data-count>${(d.text ?? '').length.toLocaleString()}</span> / 60,000자</p>
        <p class="field-error" hidden></p>
        <div class="privacy"><strong>원고는 저장하지 않아요</strong>
          <span>원고는 나눔지를 만드는 데에만 쓰이고, 이 사이트 어디에도 저장되지 않아요. 운영자를 포함해 누구도 원고를 볼 수 없어요. 보낸 원고는 AI 학습에도 쓰이지 않아요.</span></div>`,
        primary: ['다음', () => {
          const v = view.querySelector<HTMLTextAreaElement>('.field')!.value.trim();
          if (v.length >= 200) return go(1, { text: v, pdf: undefined });
          if (d.pdf) return go(1, { text: '' });            // PDF를 그대로 스밈에게 보내요
          return fieldError('원고가 너무 짧아요. 원고 전체를 넣어 주세요');
        }] });
      const ta = view.querySelector<HTMLTextAreaElement>('.field')!;
      ta.oninput = () => { view.querySelector('[data-count]')!.textContent = ta.value.length.toLocaleString(); view.querySelector<HTMLElement>('.field-error')!.hidden = true; };
      view.querySelector<HTMLInputElement>('input[type=file]')!.onchange = async (e) => {
        const input = e.target as HTMLInputElement;
        const f = input.files?.[0]; if (!f) return;
        const label = view.querySelector<HTMLElement>('.file-btn span')!;
        const fn = view.querySelector<HTMLElement>('.file-name')!;
        const was = label.textContent;
        label.textContent = '읽는 중…'; fn.textContent = `${f.name} 읽는 중…`; fn.hidden = false;
        const timeout = <T,>(p: Promise<T>) => Promise.race([p, new Promise<T>((_, no) => setTimeout(() => no(new Error('timeout')), 30000))]);
        try {
          let text = '';
          const lower = f.name.toLowerCase();
          if (lower.endsWith('.pdf') || f.type === 'application/pdf') {
            text = await timeout(pdfText(f)).catch((err) => { console.warn('pdf text', err); return ''; });
            // 이 기기에서 글자를 꺼내지 못하면(브라우저 차이, 스캔한 PDF 등) PDF를 그대로 스밈에게 보내요
            if (text.replace(/\s/g, '').length < 100) {
              if (f.size > 8 * 1024 * 1024) { fn.hidden = true; return toast('PDF가 너무 커요(8MB 이하). 내용을 복사해 붙여 넣어 주세요'); }
              d.pdf = await fileBase64(f); d.fileName = f.name;
              ta.value = ''; ta.oninput!(new Event('input'));
              fn.textContent = `${f.name} · PDF를 그대로 스밈에게 보내요`;
              return toast('이 PDF는 스밈이 직접 읽을게요. 다음을 눌러 주세요');
            }
          } else if (lower.endsWith('.docx')) {
            const mammoth: any = await import('mammoth/mammoth.browser.min.js');
            text = (await (mammoth.default ?? mammoth).extractRawText({ arrayBuffer: await f.arrayBuffer() })).value;
          } else if (f.name.toLowerCase().endsWith('.txt') || f.type.startsWith('text/')) {
            text = await f.text();
          } else { fn.hidden = true; return toast('PDF, 워드(.docx), 텍스트(.txt) 파일만 불러올 수 있어요. 한글(.hwp)은 PDF로 저장해서 올려 주세요'); }
          d.pdf = undefined;
          ta.value = text.replace(/\n{3,}/g, '\n\n').trim().slice(0, 60000);
          ta.oninput!(new Event('input'));
          d.fileName = f.name;
          fn.textContent = f.name;
          toast('원고를 불러왔어요');
        } catch (err: any) {
          console.error(err);
          fn.textContent = '';
          fn.hidden = true;
          toast(`파일을 읽지 못했어요 (${String(err?.name ?? err?.message ?? '오류').slice(0, 30)}). PDF를 열어 내용을 복사해 붙여 넣어 주세요`);
        } finally {
          label.textContent = was;
          input.value = '';            // 같은 파일을 다시 골라도 불러올 수 있게
        }
      };
    }
    if (step === 1) {
      if (mine.length <= 1) return go(2, { communities: [...mine] });
      frame({ ...common, body: `<h2 class="screen-title">어느 공동체의 나눔지로 만들까요?</h2><p class="lead">맡은 공동체 중에서 골라 주세요.</p>
        <ul class="checks">${mine.map((c) => `<li><label><input type="checkbox" value="${c}" ${(d.communities ?? []).includes(c) ? 'checked' : ''} /><span>${esc(names[c] ?? c)}</span></label></li>`).join('')}</ul>
        <p class="field-error" hidden></p>`,
        primary: ['다음', () => {
          const picked = Array.from(view.querySelectorAll<HTMLInputElement>('input:checked')).map((i) => i.value);
          if (!picked.length) return fieldError('공동체를 하나 이상 골라 주세요');
          go(2, { communities: picked });
        }] });
    }
    if (step === 2) {
      const ask = () => {
        const note = view.querySelector<HTMLTextAreaElement>('.field')?.value.trim() ?? '';
        generate({ ...d, note });
      };
      frame({ ...common, back: () => (mine.length <= 1 ? go(0) : go(1)), body: `<h2 class="screen-title">나눔지에 바라는 점이 있나요?</h2>
        <p class="lead">강조할 내용, 적용 찬양 등을 적어 주세요. 없으면 바로 만들어도 돼요.</p>
        <textarea class="memo field" maxlength="1000" placeholder="예: 새가족이 많으니 마음 열기 질문을 쉽게 해 주세요">${esc(d.note ?? '')}</textarea>`,
        primary: ['나눔지 만들기', ask] });
    }
    if (step === 3) confirmSermon(d);
  }

  /** PDF에서 글자만 꺼내요 (내 기기 안에서만 읽고, 파일은 어디에도 보내지 않아요) */
  /** 파일을 base64 글자로 (PDF를 그대로 보낼 때) */
  const fileBase64 = (f: File) => new Promise<string>((ok, no) => {
    const r = new FileReader();
    r.onload = () => ok(String(r.result).split(',')[1] ?? '');
    r.onerror = () => no(r.error);
    r.readAsDataURL(f);
  });
  async function pdfText(f: File): Promise<string> {
    // 별도 작업 스레드(Worker) 없이 이 화면 안에서 읽어요 — 기기·브라우저마다 Worker 가 막히는 경우가 있어서
    const [pdfjs, worker]: any[] = await Promise.all([
      import('pdfjs-dist/legacy/build/pdf.min.mjs'),
      import('pdfjs-dist/legacy/build/pdf.worker.min.mjs'),
    ]);
    (globalThis as any).pdfjsWorker = worker;
    const task = pdfjs.getDocument({ data: new Uint8Array(await f.arrayBuffer()), cMapUrl: '/pdfjs/cmaps/', cMapPacked: true });
    const pdf = await task.promise;
    const pages: string[] = [];
    for (let i = 1; i <= Math.min(pdf.numPages, 60); i++) {
      const tc = await (await pdf.getPage(i)).getTextContent();
      pages.push(tc.items.map((it: any) => (it.str ?? '') + (it.hasEOL ? '\n' : '')).join(''));
    }
    await task.destroy();
    return pages.join('\n\n');
  }

  async function generate(d: Sermon) {
    const run = ++makeRun;
    const making = () => {
      frame({ title: '설교 원고 올리기', step: [3, SSTEPS], back: listScreen,
        body: `<div class="making"><span class="spinner"></span></div>
          <h1 class="big-title center">스밈이 나눔지를<br />만들고 있어요</h1>
          <p class="lead center">원고 길이에 따라 <b>1~3분쯤</b> 걸려요.</p>
          <p class="lead center small" data-written></p>
          <div class="privacy wait"><strong>기다리지 않으셔도 돼요</strong>
            <span>창을 닫아도 스밈은 계속 만들어요. 다 되면 첫 화면 <b>'스밈이 만든 나눔지'</b>에 나타나요.</span></div>`,
        primary: ['기다리지 않고 나가기', listScreen],
        ...(canNotify() ? { secondary: ['다 되면 알림 받기', async () => {
          try { const r = await Notification.requestPermission(); toast(r === 'granted' ? '다 되면 알려 드릴게요' : '알림을 허락하지 않았어요. 첫 화면에서 확인해 주세요'); } catch {}
          if (onMaking) making();
        }] as [string, () => void] } : {}),
      });
      onMaking = true;
    };
    making();
    try {
      const { gbs, id } = await makeGbs(d.text ?? '', d.communities!, d.note ?? '', (n) => {
        const w = view.querySelector<HTMLElement>('[data-written]');
        if (w && onMaking && run === makeRun) w.textContent = `나눔지를 쓰는 중이에요 · ${n.toLocaleString()}자`;
      }, d.pdf);
      // 이 화면에서 기다리고 있었다면 바로 확인 화면으로 (떠났다면 첫 화면과 알림으로 안내해요)
      if (run !== makeRun || !onMaking) return;
      if (!gbs.date) gbs.date = today();
      sermonStep(3, { ...d, gbs, draftId: id });
    } catch (e) {
      console.error(e);
      if (run !== makeRun || !onMaking) return;
      frame({ title: '설교 원고 올리기', back: () => sermonStep(2, d),
        body: `<h1 class="big-title center" style="margin-top:20vh">나눔지를 만들지 못했어요</h1>
          <p class="lead center">${esc(aiError(e, '인터넷 연결을 확인하고 다시 해 주세요.'))}</p>`,
        primary: ['다시 만들기', () => generate(d)], secondary: ['목록으로', listScreen] });
    }
  }

  // ── 만든 나눔지 검토·수정 → 배포 (한 화면에 하나씩)
  //  1 설교 정보 · 2 요약 · 3 나눔 질문 · 4 5일 묵상 · 5 기도와 찬양 · 6 배포
  const ESTEPS = 6;
  function confirmSermon(d: Sermon) { editDraft(d, 0); }
  async function keepDraft(d: Sermon) {
    // 고친 내용을 초안에 저장해 두면, 나중에 다시 와도 이어서 할 수 있어요
    if (!d.draftId || !d.gbs) return;
    try { await updateDoc(doc(db, 'drafts', d.draftId), { gbs: d.gbs }); } catch (e) { console.warn('keepDraft', e); }
  }
  function editDraft(d: Sermon, step: number) {
    const g = d.gbs!;
    const go = (n: number, patch: Partial<MadeGbs> = {}) => { const nd = { ...d, gbs: { ...g, ...patch } }; keepDraft(nd); editDraft(nd, n); };
    const common = { title: d.editFile ? '나눔지 수정' : '나눔지 검토', step: [step + 1, ESTEPS] as [number, number], back: step ? () => editDraft(d, step - 1) : listScreen };
    const ta = (k: string, v: string, rows = 3, ph = '') => `<textarea class="memo field ed-ta" data-k="${k}" rows="${rows}" placeholder="${ph}">${esc(v ?? '')}</textarea>`;
    const inp = (k: string, v: string, ph = '', type = 'text') => `<input class="field" data-k="${k}" type="${type}" placeholder="${ph}" value="${esc(v ?? '')}" />`;
    const val = (k: string) => (view.querySelector<HTMLInputElement>(`[data-k="${k}"]`)?.value ?? '').trim();
    const head = (t: string, sub: string) => `<p class="eyebrow">${esc(g.title)} · ${esc(g.passage)}</p><h2 class="screen-title">${t}</h2><p class="lead">${sub}</p>`;

    if (step === 0) {
      frame({ ...common, body: head('설교 정보가 맞나요?', '원고에서 찾은 내용이에요. 비어 있거나 틀린 칸만 고쳐 주세요.') + `
        <div class="kv-fields">
          <label class="kv-field"><span>제목</span>${inp('title', g.title, '설교 제목')}</label>
          <label class="kv-field"><span>본문</span>${inp('passage', g.passage, '예: 창세기 22:4–14')}</label>
          <label class="kv-field"><span>설교자</span>${inp('preacher', g.preacher, '예: 이준건 목사')}</label>
          <label class="kv-field"><span>날짜</span>${inp('date', g.date, '', 'date')}</label>
          <label class="kv-field"><span>예배</span>${inp('service', g.service, '없으면 비워 둬도 돼요')}</label>
        </div>
        <ul class="svc-chips">${SERVICES.map((x) => `<li><button type="button" class="chip" data-svc="${x}">${x}</button></li>`).join('')}</ul>
        <p class="field-error" hidden></p>`,
        primary: ['다음', () => {
          const v = { title: val('title'), passage: val('passage'), preacher: val('preacher'), date: val('date'), service: val('service') };
          if (!v.title) return fieldError('제목을 적어 주세요');
          if (!v.passage) return fieldError('본문을 적어 주세요');
          if (!v.preacher) return fieldError('원고에 설교자가 없어요. 설교자를 적어 주세요');
          if (!/^\d{4}-\d{2}-\d{2}$/.test(v.date)) return fieldError('날짜를 골라 주세요');
          go(1, v);
        }] });
      view.querySelectorAll<HTMLElement>('[data-svc]').forEach((b) => (b.onclick = () => (view.querySelector<HTMLInputElement>('[data-k="service"]')!.value = b.dataset.svc!)));
    }
    if (step === 1) {
      frame({ ...common, body: head('설교 요약이 맞나요?', '고칠 곳이 있으면 바로 고쳐 주세요.') + `
        <label class="ed"><span>핵심 메시지</span>${ta('key', g.key, 2)}</label>
        ${g.summary.map((x, i) => `<label class="ed"><span>요약 ${i + 1}</span>${ta(`s${i}`, x, 3)}</label>`).join('')}
        <p class="field-error" hidden></p>`,
        primary: ['다음', () => {
          const summary = g.summary.map((_, i) => val(`s${i}`)).filter(Boolean);
          if (!val('key') || !summary.length) return fieldError('핵심 메시지와 요약을 채워 주세요');
          go(2, { key: val('key'), summary });
        }] });
    }
    if (step === 2) {
      const qs = g.share.questions;
      frame({ ...common, body: head(`나눔 질문 ${qs.length}개`, '소그룹 나눔방에서도 이 질문을 그대로 써요.') + `
        ${qs.map((q, i) => `<div class="ed q-ed"><input class="field tag" data-k="t${i}" maxlength="20" value="${esc(q.tag)}" />${ta(`q${i}`, q.text, 4)}</div>`).join('')}
        <label class="ed"><span>이번 주 실천</span>${ta('practice', g.share.practice, 2)}</label>
        <p class="field-error" hidden></p>`,
        primary: ['다음', () => {
          const questions = qs.map((q, i) => ({ tag: val(`t${i}`) || q.tag, text: val(`q${i}`) })).filter((q) => q.text);
          if (!questions.length) return fieldError('나눔 질문을 하나 이상 남겨 주세요');
          go(3, { share: { ...g.share, questions, practice: val('practice') } });
        }] });
    }
    if (step === 3) {
      frame({ ...common, body: head(`${g.devotions.length}일 묵상`, '설교 다음 날부터 하루에 하나씩 묵상해요.') + `
        ${g.devotions.map((v, i) => `<div class="ed dv-ed"><span>${i + 1}일째</span>
          <div class="dv-top"><input class="field" data-k="r${i}" value="${esc(v.ref)}" placeholder="본문" /><input class="field" data-k="h${i}" value="${esc(v.title)}" placeholder="제목" /></div>
          ${ta(`b${i}`, v.body, 4, '묵상 글')}${ta(`x${i}`, v.question, 2, '오늘의 질문')}</div>`).join('')}`,
        primary: ['다음', () => go(4, { devotions: g.devotions.map((v, i) => ({ ref: val(`r${i}`), title: val(`h${i}`), body: val(`b${i}`), question: val(`x${i}`) })) })] });
    }
    if (step === 4) {
      frame({ ...common, body: head('기도와 적용 찬양', '함께 드리는 기도예요.') + `
        ${g.prayers.map((x, i) => `<label class="ed"><span>기도 ${i + 1}</span>${ta(`p${i}`, x, 2)}</label>`).join('')}
        <label class="ed"><span>적용 찬양 (쉼표로 구분, 없으면 비워 두세요)</span>${inp('songs', g.songs.join(', '), '예: 주 하나님 지으신 모든 세계')}</label>`,
        primary: ['다음', () => go(5, {
          prayers: g.prayers.map((_, i) => val(`p${i}`)).filter(Boolean),
          songs: val('songs').split(',').map((x) => x.trim()).filter(Boolean),
        })] });
    }
    if (step === 5) { if (d.editFile) saveEdited(d); else deployDraft(d); }
  }

  // 이미 올린 나눔지 고친 내용 저장
  function saveEdited(d: Sermon) {
    const g = d.gbs!;
    frame({ title: '나눔지 수정', step: [6, ESTEPS], back: () => editDraft(d, 4),
      body: `<h2 class="screen-title">고친 내용을 저장할까요?</h2>
        <p class="lead">저장하면 1~2분 뒤 공동체 화면에 반영돼요. 배포 상태는 그대로예요.</p>
        <div class="summary-card"><strong>${esc(g.title)}</strong><span>${esc(g.passage)} · ${esc(g.preacher)}</span></div>`,
      primary: ['저장하기', () => busy(async () => {
        try { await updateGbs(d.editFile!, g); } catch (e) { return failBtn(e, '저장하기'); }
        const it = items.find((i) => i.file === d.editFile);
        if (it) Object.assign(it, { title: g.title, passage: g.passage, preacher: g.preacher, full: g });
        toast('저장했어요. 1~2분 뒤 반영돼요');
        listScreen();
      })] });
  }
  // 나눔지 지우기 — 확인 창
  function deleteScreen(file: string, title: string) {
    const dlg = document.createElement('div');
    dlg.className = 'dialog-backdrop';
    dlg.innerHTML = `<div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="dlg-d">
        <h2 id="dlg-d">「${esc(title)}」 나눔지를<br />지울까요?</h2>
        <p>공동체 화면과 목록에서 사라지고<br />되돌릴 수 없어요.</p>
        <div class="dialog-actions"><button type="button" class="dlg-cancel">취소</button><button type="button" class="dlg-ok">지우기</button></div></div>`;
    document.body.append(dlg);
    requestAnimationFrame(() => dlg.classList.add('on'));
    const close = () => { dlg.classList.remove('on'); setTimeout(() => dlg.remove(), 200); };
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.querySelector<HTMLButtonElement>('.dlg-cancel')!.onclick = close;
    const ok = dlg.querySelector<HTMLButtonElement>('.dlg-ok')!;
    ok.onclick = async () => {
      ok.disabled = true; ok.textContent = '지우는 중…';
      try { await deleteGbs(file); }
      catch (e) { ok.disabled = false; ok.textContent = '지우기'; return toast(aiError(e, '지우지 못했어요. 다시 해 주세요.')); }
      const id = `shared__${file}`;
      delete approvals[id];
      const i = items.findIndex((x) => x.file === file); if (i >= 0) items.splice(i, 1);
      close(); toast('지웠어요. 1~2분 뒤 공동체 화면에서도 사라져요'); listScreen();
    };
  }

  // 배포 — 공동체를 고르고 (없으면 이름만 적어 바로 만들고) 배포해요
  function deployDraft(d: Sermon) {
    const g = d.gbs!;
    const back = () => editDraft(d, 4);
    const common = { title: '나눔지 배포', step: [6, ESTEPS] as [number, number], back };
    if (!mine.length) {
      frame({ ...common, body: `<h2 class="screen-title">어느 공동체에 배포할까요?</h2>
          <p class="lead">아직 공동체가 없어요. 공동체 이름만 적으면 바로 만들고 배포해요. 소개는 나중에 고칠 수 있어요.</p>
          <input class="field one" maxlength="20" placeholder="예: 하손내빚" /><p class="field-error" hidden></p>`,
        primary: ['공동체 만들고 배포하기', () => {
          const name = view.querySelector<HTMLInputElement>('.field')!.value.trim().replace(/\s+/g, ' ');
          if (!name) return fieldError('공동체 이름을 적어 주세요');
          busy(async () => {
            let r: { slug: string; name: string };
            try { r = await createCommunity(name); }
            catch (e) { return failBtn(e, '공동체 만들고 배포하기'); }
            mine = [...mine, r.slug]; names[r.slug] = r.name; info[r.slug] = { name: r.name, tagline: '', intro: '', worship: [] };
            await publish(d, [r.slug], '공동체 만들고 배포하기');
          });
        }] });
      return;
    }
    const picked = d.communities?.length ? d.communities.filter((c) => mine.includes(c)) : mine.length === 1 ? [...mine] : [];
    frame({ ...common, body: `<h2 class="screen-title">어느 공동체에 배포할까요?</h2>
        <p class="lead">배포하면 1~2분 뒤 공동체 화면에 나타나요. 언제든 거둬들일 수 있어요.</p>
        <ul class="checks">${mine.map((c) => `<li><label><input type="checkbox" value="${c}" ${picked.includes(c) ? 'checked' : ''} /><span>${esc(names[c] ?? c)}</span></label></li>`).join('')}</ul>
        <div class="summary-card"><strong>${esc(g.title)}</strong><span>${esc(g.passage)} · ${esc(g.preacher)}</span></div>
        <p class="field-error" hidden></p>`,
      primary: ['배포하기', () => {
        const cs = Array.from(view.querySelectorAll<HTMLInputElement>('input:checked')).map((i) => i.value);
        if (!cs.length) return fieldError('공동체를 하나 이상 골라 주세요');
        busy(() => publish(d, cs, '배포하기'));
      }],
      secondary: ['새 공동체 만들기', () => createScreen(() => deployDraft(d))] });
  }
  function failBtn(e: unknown, label: string) {
    toast(aiError(e, '처리하지 못했어요. 다시 해 주세요.'));
    const b = cta.querySelector<HTMLButtonElement>('.btn'); if (b) { b.disabled = false; b.textContent = label; }
  }
  // 사이트에 올리고 → 고른 공동체에 바로 배포(승인) 표시
  async function publish(d: Sermon, cs: string[], label: string) {
    const g = d.gbs!;
    let slug: string;
    try { slug = await submitGbs(g, cs, d.draftId); } catch (e) { return failBtn(e, label); }
    const id = `shared__${slug}`;
    try {
      for (const c of cs) await setDoc(doc(db, 'approvals', `${id}~${c}`), { gbs: id, community: c, title: g.title, by: user!.email, at: serverTimestamp() });
      approvals[id] = cs; approvalTitles[id] = g.title;
    } catch (e) { console.warn('approve', e); toast('사이트에 올렸어요. 배포 표시는 검수 목록에서 다시 해 주세요'); }
    doneScreen({ id, slug, title: g.title, passage: g.passage } as Item, cs, true);
  }

  // ── 3. 검수 단계 (한 화면에 하나씩)
  const STEPS = 6;
  function review(it: Item, step: number) {
    const go = (n: number) => () => review(it, n);
    const head = (t: string) => `<p class="eyebrow">${esc(it.title)} · ${esc(it.passage)}</p><h2 class="screen-title">${t}</h2>`;
    const common = { title: `검수 ${Math.min(step + 1, STEPS)} / ${STEPS}`, step: [step + 1, STEPS] as [number, number], back: step ? go(step - 1) : listScreen };
    if (step === 0) frame({ ...common, body: head('설교 요약이 맞나요?') +
      `<p class="key">${esc(it.key)}</p><ol class="sum">${it.summary.map((s) => `<li>${esc(s)}</li>`).join('')}</ol>`,
      primary: ['확인했어요', go(1)] });
    if (step === 1) frame({ ...common, body: head(`나눔 질문 ${it.questions.length}개`) +
      `<ol class="qlist">${it.questions.map((q) => `<li><span class="tag">${esc(q.tag)}</span><p>${esc(q.text)}</p></li>`).join('')}</ol>` +
      (it.practice ? `<div class="note"><strong>이번 주 실천</strong><br />${esc(it.practice)}</div>` : ''),
      primary: ['확인했어요', go(2)] });
    if (step === 2) frame({ ...common, body: head(`${it.devotions.length}일 묵상`) +
      `<ol class="qlist">${it.devotions.map((v) => `<li><span class="tag">${esc(v.day)} · ${esc(v.ref)}</span><p><strong>${esc(v.title)}</strong><br />${esc(v.question)}</p></li>`).join('')}</ol>`,
      primary: ['확인했어요', go(3)] });
    if (step === 3) frame({ ...common, body: head('기도와 적용 찬양') +
      `<ol class="sum">${it.prayers.map((p) => `<li>${esc(p)}</li>`).join('')}</ol>
       <div class="songs">${it.songs.map((s) => `<span>${esc(s)}</span>`).join('')}</div>`,
      primary: ['확인했어요', go(4)] });
    if (step === 4) {
      const choices = it.targets.filter((t) => mine.includes(t));
      const current = approvals[it.id] ?? [];
      frame({ ...common, body: head('어느 공동체에 보낼까요?') +
        `<p class="lead">맡은 공동체에만 보낼 수 있어요.</p>
         <ul class="checks">${choices.map((c) => `<li><label><input type="checkbox" value="${c}" ${current.length === 0 || current.includes(c) ? 'checked' : ''} /><span>${esc(names[c] ?? c)}</span></label></li>`).join('')}</ul>`,
        primary: ['다음', () => {
          const picked = Array.from(view.querySelectorAll<HTMLInputElement>('input:checked')).map((i) => i.value);
          if (!picked.length) return toast('공동체를 하나 이상 골라 주세요');
          confirmScreen(it, picked, choices);
        }] });
    }
  }
  function confirmScreen(it: Item, picked: string[], choices: string[]) {
    const current = approvals[it.id] ?? [];
    frame({
      title: `검수 6 / ${STEPS}`, step: [6, STEPS], back: () => review(it, 4),
      body: `<h1 class="big-title">${picked.map((c) => esc(names[c] ?? c)).join(', ')}에<br />배포할까요?</h1>
        <p class="lead">배포하면 바로 공개돼요. 언제든 거둬들일 수 있어요.</p>
        <div class="summary-card"><strong>${esc(it.title)}</strong><span>${esc(it.passage)} · ${esc(it.preacher)}</span></div>`,
      primary: ['승인하고 배포하기', () => busy(async () => {
        for (const c of choices) {
          const ref = doc(db, 'approvals', `${it.id}~${c}`);
          if (picked.includes(c)) await setDoc(ref, { gbs: it.id, community: c, title: it.title, by: user!.email, at: serverTimestamp() });
          else if (current.includes(c)) await deleteDoc(ref);
        }
        approvals = await loadApprovals();
        doneScreen(it, picked);
      })],
      secondary: current.length ? ['거둬들이기', () => pullScreen(it)] : ['수정 요청하기', () => feedbackScreen(it)],
    });
  }
  function feedbackScreen(it: Item) {
    frame({
      title: '수정 요청', back: () => review(it, 4),
      body: `<h1 class="big-title">무엇을 고칠까요?</h1>
        <p class="lead">메모를 남기면 나눔지를 만든 사람이 확인하고 고쳐요.</p>
        <textarea class="memo" maxlength="1000" placeholder="예: 말씀 2 질문을 조금 더 쉽게 바꿔 주세요"></textarea>`,
      primary: ['요청 보내기', () => busy(async () => {
        const text = view.querySelector<HTMLTextAreaElement>('.memo')!.value.trim();
        if (!text) { toast('메모를 적어 주세요'); throw new Error('empty'); }
        await addDoc(collection(db, 'feedback'), { gbs: it.id, title: it.title, text, by: user!.email, at: serverTimestamp() });
        toast('수정 요청을 보냈어요'); listScreen();
      })],
    });
  }
  function doneScreen(it: Item, picked: string[], fresh = false) {
    const c = picked[0];
    frame({
      body: `<div class="done-mark"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
        <h1 class="big-title center">${picked.map((x) => esc(names[x] ?? x)).join(', ')}에<br />배포했어요</h1>
        <p class="lead center">${esc(it.title)} · ${esc(it.passage)}${fresh ? '<br />1~2분 뒤 공동체 화면에 나타나요.' : ''}</p>
        <div class="share-qr-row"><button type="button" class="qr-cta" data-done-qr>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2v2h-2zM18 14h2v2h-2zM14 18h2v2h-2zM18 18h2v2h-2z" /></svg>
          <span><strong>공동체 QR 받기</strong><small>QR을 저장해 공동체에 전달해 주세요</small></span></button></div>`,
      primary: ['나눔지 보기', () => (location.href = `/${c}/gbs/${it.slug}${emu}`)],
      secondary: ['목록으로', listScreen],
    });
    view.querySelector<HTMLElement>('[data-done-qr]')!.onclick = () => qrPopup(picked);
  }

  // ── 시작
  frame({ body: '<p class="lead center" style="margin-top:40vh">불러오는 중…</p>' });
  onAuthStateChanged(auth, async (u) => {
    user = u && !u.isAnonymous ? u : null;
    if (!user) return loginScreen();
    try {
      const s = await getDoc(doc(db, 'staff', user.email!));
      registered = s.exists();
      mine = s.exists() ? (s.data().communities as string[]) ?? [] : [];
      isAdmin = s.exists() && s.data().admin === true;
    } catch { mine = []; registered = false; }
    if (!registered) return signupStart();
    try { approvals = await loadApprovals(); } catch { approvals = {}; }
    try { (await getDocs(collection(db, 'approvals'))).forEach((x) => { const v = x.data() as any; if (v.title) approvalTitles[v.gbs] = v.title; }); } catch {}
    if (isAdmin) {
      // 새 신청이 들어오면 바로 숫자가 바뀌어요
      onSnapshot(collection(db, 'staffRequests'), (q) => { pendingStaff = q.size; if (onList) listScreen(); }, (e) => console.warn('staffRequests', e));
    }
    watchDrafts();
    listScreen();
  });
</script>

