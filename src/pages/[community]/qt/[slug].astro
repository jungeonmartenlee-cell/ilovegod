---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FormButton from '../../../components/FormButton.astro';
import { getSortedQt, formatDate, qtSlug, qtUrl, type Qt } from '../../../lib/qt';
import { communities, type CommunityEntry } from '../../../communities';

export async function getStaticPaths() {
  const paths = [];
  for (const community of communities) {
    const qts = await getSortedQt(community.slug);
    paths.push(...qts.map((qt, i) => ({
      params: { community: community.slug, slug: qtSlug(qt) },
      props: { community, qt, newer: qts[i - 1], older: qts[i + 1] },
    })));
  }
  return paths;
}

interface Props { community: CommunityEntry; qt: Qt; newer?: Qt; older?: Qt }
const { community, qt, newer, older } = Astro.props;
const { Content } = await render(qt);
const { title, passage, preacher, date, summary } = qt.data;
---
<BaseLayout community={community} title={`${title} (${passage})`} description={summary ?? `${passage} · ${preacher}`}>
  <article>
    <header class="qt-head">
      <span class="eyebrow">{formatDate(date)}</span>
      <h1>{title}</h1>
      <p class="passage">{passage}</p>
      <p class="muted preacher">설교 · {preacher}</p>
      <button class="btn ghost share" type="button" data-share>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3.5M8 7.5l4-4 4 4M6 11H5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1h-1"/></svg>
        <span data-share-label>공유</span>
      </button>
    </header>

    <div class="prose">
      <Content />
    </div>
    <FormButton community={community} />
  </article>

  <nav class="pager group" aria-label="다른 주 큐티">
    {newer && (
      <a href={qtUrl(newer)}>
        <span class="dir">다음 주</span><span class="t">{newer.data.title}</span><svg class="chev" viewBox="0 0 8 13" aria-hidden="true"><path d="M1.5 1.5 6.5 6.5 1.5 11.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    )}
    {older && (
      <a href={qtUrl(older)}>
        <span class="dir">지난 주</span><span class="t">{older.data.title}</span><svg class="chev" viewBox="0 0 8 13" aria-hidden="true"><path d="M1.5 1.5 6.5 6.5 1.5 11.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    )}
    <a href={`/${community.slug}/qt`}>
      <span class="dir">목록</span><span class="t">큐티 전체 보기</span><svg class="chev" viewBox="0 0 8 13" aria-hidden="true"><path d="M1.5 1.5 6.5 6.5 1.5 11.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </nav>
</BaseLayout>

<script>
  // 휴대폰에서는 카카오톡 등으로 바로 공유, 안 되면 주소 복사
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const data = { title: document.title, url: location.href };
      try {
        if (navigator.share) return await navigator.share(data);
        await navigator.clipboard.writeText(location.href);
        const label = btn.querySelector('[data-share-label]');
        if (label) label.textContent = '주소 복사됨';
      } catch { /* 사용자가 취소함 */ }
    });
  });
</script>

<style>
  .qt-head { padding: 12px 0 24px; }
  .qt-head h1 { margin: 6px 0 6px; font-size: 2rem; }
  .passage { margin: 0; font-size: 1.12rem; font-weight: 600; color: var(--accent); }
  .preacher { margin: 2px 0 18px; font-size: .9rem; }
  .share { min-height: 38px; padding: 0 16px; font-size: .88rem; }
  .share svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  /* ── 마크다운 본문 ── */
  .prose { font-size: 1.04rem; line-height: 1.8; }
  .prose :global(h2) {
    margin: 44px 0 12px;
    font-size: .82rem;
    font-weight: 600;
    letter-spacing: .02em;
    color: var(--muted);
  }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(strong) { font-weight: 700; }

  /* 성경 본문 */
  .prose :global(blockquote) {
    margin: 0 0 1em;
    padding: 20px 20px 8px;
    border-radius: var(--radius);
    background: var(--glass);
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
    border: 0.5px solid var(--glass-edge);
    box-shadow: var(--glass-shadow);
    font-size: 1.08rem;
    line-height: 1.9;
  }
  .prose :global(blockquote p) { margin: 0 0 .75em; }
  .prose :global(blockquote sup) { font-size: .7em; font-weight: 700; color: var(--accent); margin-right: 3px; }

  /* 질문 */
  .prose :global(ol) {
    list-style: none;
    counter-reset: q;
    margin: 0 0 1em;
    padding: 0;
    border-radius: var(--radius);
    background: var(--glass);
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
    border: 0.5px solid var(--glass-edge);
    box-shadow: var(--glass-shadow);
    overflow: hidden;
  }
  .prose :global(ol > li) {
    counter-increment: q;
    position: relative;
    padding: 16px 18px 16px 50px;
    line-height: 1.65;
  }
  .prose :global(ol > li + li) { border-top: 0.5px solid var(--line); }
  .prose :global(ol > li::before) {
    content: counter(q);
    position: absolute;
    left: 18px; top: 16px;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .prose :global(ul) { padding-left: 1.2em; margin: 0 0 1em; }
  .prose :global(ul > li) { margin-bottom: .4em; }
  .prose :global(ul > li::marker) { color: var(--faint); }
  .prose :global(hr) { border: 0; border-top: 0.5px solid var(--line); margin: 32px 0; }

  .pager { margin-top: 48px; }
  .pager a { position: relative; display: flex; align-items: center; gap: 12px; padding: 14px 18px; text-decoration: none; }
  .pager a + a { border-top: 0.5px solid var(--line); }
  .pager a:active { background: var(--surface-2); }
  .dir { flex: none; width: 52px; font-size: .82rem; font-weight: 600; color: var(--muted); }
  .t { flex: 1; min-width: 0; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
