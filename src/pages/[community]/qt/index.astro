---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QtListItem from '../../../components/QtListItem.astro';
import { getSortedQt } from '../../../lib/qt';
import { communities, type CommunityEntry } from '../../../communities';

export function getStaticPaths() {
  return communities.map((c) => ({ params: { community: c.slug }, props: { community: c } }));
}
const { community } = Astro.props as { community: CommunityEntry };
const base = `/${community.slug}`;

const qts = await getSortedQt(community.slug);

// 연도별로 묶기
const byYear = new Map<number, typeof qts>();
for (const qt of qts) {
  const y = qt.data.date.getUTCFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), qt]);
}
---
<BaseLayout community={community} title="큐티 나눔" description="주일 설교 본문에 따른 주간 큐티 나눔 자료 모음">
    <h1>큐티 나눔</h1>
  <p class="muted">주일 설교 본문으로 한 주 동안 묵상하고, 소그룹에서 나눠요.</p>

  {qts.length === 0 && <p class="muted">아직 올라온 큐티가 없어요.</p>}

  {[...byYear].map(([year, list]) => (
    <section>
      <h2 class="section-title">{year}년</h2>
      <div class="group">{list.map((qt) => <QtListItem qt={qt} />)}</div>
    </section>
  ))}
</BaseLayout>

<style>
  h1 { margin-top: 12px; }
  section .section-title { margin: 32px 0 12px; font-size: 1.4rem; }
</style>
