---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QtListItem from '../../components/QtListItem.astro';
import FormButton from '../../components/FormButton.astro';
import { getSortedQt, formatDate, qtUrl } from '../../lib/qt';
import { communities, type CommunityEntry } from '../../communities';

export function getStaticPaths() {
  return communities.map((c) => ({ params: { community: c.slug }, props: { community: c } }));
}
const { community } = Astro.props as { community: CommunityEntry };
const base = `/${community.slug}`;
const { mainName, parentNames, tagline, intro, worship } = community;

const qts = await getSortedQt(community.slug);
const latest = qts[0];
const recent = qts.slice(1, 4);
---
<BaseLayout community={community}>
  {latest ? (
    <a class="qt-hero glass" href={qtUrl(latest)}>
      <span class="label">이번 주 큐티</span>
      <h1>{latest.data.title}</h1>
      <p class="passage">{latest.data.passage}</p>
      {latest.data.summary && <p class="summary">{latest.data.summary}</p>}
      <span class="foot">
        <span class="meta">{formatDate(latest.data.date)} · {latest.data.preacher}</span>
        <span class="btn go">묵상하기</span>
      </span>
    </a>
  ) : (
    <div class="card muted">아직 올라온 큐티가 없어요.</div>
  )}
  <FormButton community={community} />

  <section class="intro">
    {parentNames && <span class="names">{parentNames}</span>}
    <h2>{mainName}<span class="tag">{tagline}</span></h2>
    <p class="muted">{intro}</p>
    <a href={`${base}/about`} class="link">공동체 소개 <svg class="chev" viewBox="0 0 8 13" aria-hidden="true"><path d="M1.5 1.5 6.5 6.5 1.5 11.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  </section>

  <h2 class="section-title">예배 안내</h2>
  <div class="group">
    {worship.map((w) => (
      <div class="worship">
        <span class="w-label">{w.label}</span>
        <strong>{w.time}</strong>
        <span class="muted">{w.place}</span>
      </div>
    ))}
  </div>

  {recent.length > 0 && (
    <>
      <h2 class="section-title">지난 큐티</h2>
      <div class="group">{recent.map((qt) => <QtListItem qt={qt} />)}</div>
      <p class="more-wrap"><a href={`${base}/qt`} class="link">모두 보기 <svg class="chev" viewBox="0 0 8 13" aria-hidden="true"><path d="M1.5 1.5 6.5 6.5 1.5 11.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
    </>
  )}
</BaseLayout>

<style>
  .qt-hero { display: block; padding: 24px 22px 20px; border-radius: 28px; text-decoration: none; }
  .label { font-size: .8rem; font-weight: 600; color: var(--accent); }
  .qt-hero h1 { margin: 8px 0 4px; font-size: 1.85rem; }
  .passage { margin: 0; font-size: 1.05rem; font-weight: 600; color: var(--muted); }
  .summary { margin: 14px 0 0; font-size: .97rem; line-height: 1.65; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 20px; }
  .meta { font-size: .8rem; color: var(--faint); }
  .go { min-height: 40px; padding: 0 18px; font-size: .9rem; }

  .intro { margin-top: 44px; }
  .names { font-size: .7rem; font-weight: 600; letter-spacing: .16em; color: var(--faint); }
  .intro h2 { margin: 4px 0 8px; font-size: 1.6rem; }
  .tag { display: block; font-size: 1.05rem; font-weight: 600; color: var(--muted); letter-spacing: -0.02em; margin-top: 2px; }
  .intro p { margin: 0 0 10px; }
  .link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-weight: 600; text-decoration: none; }
  .link :global(.chev) { color: var(--accent); }

  .worship { display: flex; flex-direction: column; padding: 16px 18px; }
  .worship + .worship { border-top: 0.5px solid var(--line); }
  .w-label { font-size: .8rem; font-weight: 600; color: var(--muted); }
  .worship strong { font-size: 1.1rem; font-weight: 700; }
  .worship .muted { font-size: .92rem; }

  .more-wrap { margin: 12px 4px 0; }
</style>
