---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GbsListItem from '../../components/GbsListItem.astro';
import FormButton from '../../components/FormButton.astro';
import GbsArt from '../../components/GbsArt.astro';
import { getSortedGbs, formatDate, gbsUrl } from '../../lib/gbs';
import { communities, type CommunityEntry } from '../../communities';

export function getStaticPaths() {
  return communities.map((c) => ({ params: { community: c.slug }, props: { community: c } }));
}
const { community } = Astro.props as { community: CommunityEntry };
const base = `/${community.slug}`;
const { mainName, parentNames, tagline, intro, worship } = community;

const items = await getSortedGbs(community.slug);
const latest = items[0];
const recent = items.slice(1, 4);
---
<BaseLayout community={community}>
  <h1 class="page-title">이번 주 말씀</h1>
  {latest ? (
    <a class="gbs-card" href={gbsUrl(latest)}>
      <span class="art"><GbsArt /></span>
      <span class="tinted">
        <span class="t">{latest.data.title}</span>
        <span class="passage">{latest.data.passage}</span>
        {latest.data.summary && <span class="summary">{latest.data.summary}</span>}
        <span class="foot">
          <span class="btn go">나눔 시작하기</span>
          <span class="meta">{formatDate(latest.data.date)}<br />{latest.data.preacher}</span>
        </span>
      </span>
    </a>
  ) : (
    <div class="card muted">아직 올라온 GBS 자료가 없어요.</div>
  )}
  <FormButton community={community} />

  <section class="intro">
    {parentNames && <span class="names">{parentNames}</span>}
    <h2>{mainName}<span class="tag">{tagline}</span></h2>
    <p class="muted">{intro}</p>
    <a href={`${base}/about`} class="link">공동체 소개 <svg class="chev" viewBox="0 0 8 13" aria-hidden="true"><path d="M1.5 1.5 6.5 6.5 1.5 11.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  </section>

  <h2 class="section-title">예배 안내</h2>
  <div class="group">
    {worship.map((w) => (
      <div class="worship">
        <span class="w-label">{w.label}</span>
        <strong>{w.time}</strong>
        <span class="muted">{w.place}</span>
      </div>
    ))}
  </div>

  {recent.length > 0 && (
    <>
      <h2 class="section-title">지난 GBS</h2>
      <div class="group">{recent.map((gbs) => <GbsListItem gbs={gbs} />)}</div>
      <p class="more-wrap"><a href={`${base}/gbs`} class="link">모두 보기 <svg class="chev" viewBox="0 0 8 13" aria-hidden="true"><path d="M1.5 1.5 6.5 6.5 1.5 11.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
    </>
  )}
</BaseLayout>

<style>
  .page-title { margin: 20px 0 16px; font-size: 1.9rem; }

  .gbs-card {
    display: block;
    overflow: hidden;
    border-radius: 32px;
    background: var(--card);
    border: 0.5px solid var(--line);
    text-decoration: none;
  }
  .art { display: block; padding: 26px 26px 18px; }
  .tinted {
    display: flex;
    flex-direction: column;
    padding: 24px 24px 22px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--tint) 70%, var(--card)), var(--tint));
    border-top: 0.5px solid var(--line);
  }
  .t { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1.3; }
  .passage { margin-top: 2px; font-size: 1.05rem; font-weight: 700; letter-spacing: -0.02em; }
  .summary { margin-top: 10px; font-size: .97rem; line-height: 1.6; color: var(--muted); }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 20px; }
  .go { min-height: 44px; padding: 0 24px; }
  .meta { font-size: .78rem; line-height: 1.45; color: var(--faint); text-align: right; }

  .intro { margin-top: 48px; }
  .names { font-size: .7rem; font-weight: 600; letter-spacing: .16em; color: var(--faint); }
  .intro h2 { margin: 4px 0 8px; font-size: 1.65rem; font-weight: 800; letter-spacing: -0.04em; }
  .tag { display: block; font-size: 1.05rem; font-weight: 600; color: var(--muted); letter-spacing: -0.02em; margin-top: 2px; }
  .intro p { margin: 0 0 10px; }
  .link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-weight: 600; text-decoration: none; }
  .link :global(.chev) { color: var(--accent); }

  .worship { display: flex; flex-direction: column; padding: 18px 20px; }
  .worship + .worship { border-top: 0.5px solid var(--line); }
  .w-label { font-size: .8rem; font-weight: 600; color: var(--muted); }
  .worship strong { font-size: 1.15rem; font-weight: 700; }
  .worship .muted { font-size: .92rem; }

  .more-wrap { margin: 12px 4px 0; }
</style>
