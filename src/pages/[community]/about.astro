---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { communities, type CommunityEntry } from '../../communities';

export function getStaticPaths() {
  return communities.map((c) => ({ params: { community: c.slug }, props: { community: c } }));
}
const { community } = Astro.props as { community: CommunityEntry };

// 이 페이지의 문구는 src/communities/공동체이름.ts 의 about 에서 바꿔요.
const { mainName, parentNames, intro, attendance, mapQuery } = community;
const worship = community.worship ?? [];
const { vision, mascot, smallGroup, org, activities, peopleTitle, people, meetings, welcome, closing } = { people: [], ...(community.about ?? {}) };
// 이름이나 사진이 아직 없는 사람은 숨겨요
const shown = (people ?? []).filter((p) => p.name || p.photo);
const featured = shown.filter((p) => p.featured);
const others = shown.filter((p) => !p.featured);
const mapUrl = mapQuery ? `https://map.naver.com/p/search/${encodeURIComponent(mapQuery)}` : '';
---
<BaseLayout community={community} title="공동체 소개" description={`${mainName} 소개 · 예배 안내 · 소그룹 안내`}>
  <h1>우리는 {mainName}입니다</h1>
  {parentNames && <p class="parents">{parentNames}</p>}
  <p class="muted lead">{intro} {attendance}</p>

  {vision && (
    <section>
      <h2 class="section-title">{vision.title ?? '비전'}</h2>
      <div class="card meaning">
        {vision.subtitle && <p class="subtitle">{vision.subtitle}</p>}
        <p class="verse">{vision.verse}<cite>{vision.ref}</cite></p>
        <ul class="points">
          {vision.points.map((p) => (
            <li><strong>{p.title}</strong>{p.text && <span class="muted">{p.text}</span>}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {mascot && (
    <div class="card mascot">
      <svg viewBox="0 0 120 110" aria-hidden="true" class="mascot-img">
        <path d="M60 104S8 72 8 36C8 18 21 6 37 6c10 0 18 5 23 13 5-8 13-13 23-13 16 0 29 12 29 30 0 36-52 68-52 68z" fill="#f9c6d3" stroke="#3a3330" stroke-width="3"/>
        <circle cx="45" cy="42" r="3.5" fill="#3a3330"/><circle cx="75" cy="42" r="3.5" fill="#3a3330"/>
        <path d="M54 52q6 5 12 0" fill="none" stroke="#e0566f" stroke-width="3" stroke-linecap="round"/>
      </svg>
      <div>
        <span class="role">{mainName} 마스코트</span>
        <strong>'{mascot.name}'</strong>
        <p class="muted">{mascot.text}</p>
      </div>
    </div>
  )}

  {worship.length > 0 && <h2 class="section-title">예배 안내</h2>}
  {worship.map((w) => (
    <dl class="card info">
      <div><dt>시간</dt><dd><strong>{w.time}</strong></dd></div>
      <div><dt>장소</dt><dd>{w.place}</dd></div>
      {w.order && <div><dt>순서</dt><dd>{w.order}</dd></div>}
      {mapUrl && <a class="btn ghost map" href={mapUrl} target="_blank" rel="noopener">지도에서 오는 길 보기</a>}
    </dl>
  ))}

  {smallGroup && (
    <section>
      <h2 class="section-title">소그룹 안내</h2>
      <p class="muted body">{smallGroup.intro}</p>
      <ol class="steps">
        {smallGroup.steps.map((s, i) => (
          <li><span class="step-num">{i + 1}</span>{s}</li>
        ))}
      </ol>
      <ul class="notes">
        {smallGroup.notes.map((n) => <li>{n}</li>)}
      </ul>
    </section>
  )}

  {activities && (
    <section>
      <h2 class="section-title">공동체 활동</h2>
      <ul class="group acts">
        {activities.items.map((a) => <li>{a}</li>)}
      </ul>
      {activities.programs?.map((pr) => (
        <div class="card program">
          <strong>{pr.title}</strong>
          <p class="muted">{pr.text}</p>
          {pr.items && <ul class="notes">{pr.items.map((i) => <li>{i}</li>)}</ul>}
        </div>
      ))}
    </section>
  )}

  {org && (
    <section>
      <h2 class="section-title">소속</h2>
      <div class="card org">
        <p class="org-title">{org.title}</p>
        <ul class="groups">
          {org.groups.map((g) => (
            <li class:list={[{ on: g.current }]}>
              <strong>{g.name}</strong>
              <span class="muted">{g.desc}</span>
              {g.children && (
                <span class="children">
                  {g.children.map((c) => <span class:list={[{ current: c === g.current }]}>{c}</span>)}
                </span>
              )}
            </li>
          ))}
        </ul>
        {org.note && <p class="org-note">{org.note}</p>}
      </div>
    </section>
  )}

  {shown.length > 0 && (
    <section>
      <h2 class="section-title">{peopleTitle ?? '섬기는 사람들'}</h2>
      {featured.map((p) => (
        <div class:list={['card pastor', { 'has-photo': p.photo }]}>
          {p.photo && <img src={`/images/${p.photo}`} alt={`${p.role} ${p.name ?? ''}`} loading="lazy" />}
          <div class="pastor-text">
            <span class="role">{p.role}</span>
            {p.name && <strong>{p.name}</strong>}
          </div>
          {p.note && <p class="pastor-note">{p.note}</p>}
        </div>
      ))}
      {others.length > 0 && (
        <ul class="group people">
          {others.map((p) => (
            <li>
              <span class="role">{p.role}</span>
              {p.name && <strong>{p.name}</strong>}
              {p.note && <span class="muted note">{p.note}</span>}
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  {meetings && meetings.length > 0 && (
    <section>
      <h2 class="section-title">모임 안내</h2>
      <ul class="meetings">
        {meetings.map((m) => <li><strong>{m.name}</strong><p class="muted">{m.desc}</p></li>)}
      </ul>
    </section>
  )}

  {welcome && (
    <div class="card welcome">
      <strong>{welcome.title}</strong>
      <p class="muted">{welcome.text}</p>
    </div>
  )}

  {closing && (
    <section class="closing">
      <p class="closing-title">{closing.title}</p>
      <p class="closing-text">{closing.text}</p>
      {closing.verse && <p class="closing-verse">“{closing.verse}”<cite>{closing.ref}</cite></p>}
    </section>
  )}
</BaseLayout>

<style>
  h1 { margin-top: 12px; }
  .parents { margin: -2px 0 14px; font-size: .7rem; font-weight: 600; letter-spacing: .16em; color: var(--faint); }
  .lead { margin: 0; font-size: 1.02rem; line-height: 1.75; }
  ul, ol { list-style: none; margin: 0; padding: 0; }
  .role { font-size: .78rem; font-weight: 600; color: var(--muted); }

  /* GIL 이란? */
  .meaning { padding: 26px 20px 8px; text-align: center; }
  .subtitle { margin: 0 0 6px; font-size: 1.35rem; font-weight: 800; letter-spacing: -0.03em; color: var(--accent); }
  .verse { margin: 0 0 18px; font-size: 1rem; font-weight: 600; }
  .verse cite { display: block; margin-top: 2px; font-style: normal; font-size: .8rem; font-weight: 500; color: var(--faint); }
  .points li { padding: 14px 4px; border-top: 0.5px solid var(--line); font-size: .97rem; line-height: 1.5; }
  .points li strong { font-weight: 600; }
  .points li span { display: block; font-size: .88rem; }

  .mascot { display: flex; align-items: center; gap: 16px; margin-top: 12px; }
  .mascot-img { flex: none; width: 64px; height: auto; }
  .mascot strong { display: block; font-size: 1.05rem; }
  .mascot p { margin: 2px 0 0; font-size: .9rem; line-height: 1.55; }

  /* 예배 안내 */
  .info { margin: 0 0 10px; display: grid; gap: 12px; }
  .info div { display: grid; grid-template-columns: 44px 1fr; gap: 8px; line-height: 1.55; }
  .info dt { font-size: .88rem; font-weight: 600; color: var(--muted); padding-top: 1px; }
  .info dd { margin: 0; }
  .map { margin-top: 6px; min-height: 42px; font-size: .9rem; }

  /* 소그룹 */
  .body { margin: 0 0 16px; line-height: 1.75; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 16px; }
  .steps li {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    padding: 14px 6px; border-radius: 18px;
    font-size: .82rem; font-weight: 600; text-align: center; line-height: 1.35;
  }
  .step-num { font-size: 1.1rem; font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
  .notes { display: grid; gap: 8px; }
  .notes li { position: relative; padding-left: 14px; font-size: .95rem; line-height: 1.7; }
  .notes li::before { content: ''; position: absolute; left: 2px; top: .72em; width: 4px; height: 4px; border-radius: 50%; background: var(--faint); }

  /* 활동 */
  .acts li { padding: 14px 18px; font-size: .97rem; font-weight: 500; }
  .acts li + li { border-top: 0.5px solid var(--line); }
  .program { margin-top: 12px; }
  .program strong { font-size: 1.02rem; }
  .program p { margin: 4px 0 8px; font-size: .94rem; line-height: 1.7; }

  /* 소속 */
  .org { text-align: center; }
  .org-title { margin: 0 0 14px; font-weight: 700; }
  .groups { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .groups li { display: flex; flex-direction: column; gap: 2px; padding: 12px 4px; border-radius: 16px; background: var(--surface-2); }
  .groups li.on { background: var(--accent-soft); box-shadow: inset 0 0 0 1.5px var(--accent); }
  .groups strong { font-size: 1.2rem; }
  .groups .muted { font-size: .7rem; line-height: 1.4; }
  .children { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; margin-top: 6px; font-size: .7rem; color: var(--muted); }
  .children .current { color: var(--accent); font-weight: 800; }
  .org-note { margin: 14px 0 0; font-size: .9rem; color: var(--muted); }

  /* 사람들 */
  .pastor { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 14px 16px; margin-bottom: 12px; }
  .pastor.has-photo { display: flex; flex-direction: column; align-items: stretch; padding-top: 14px; }
  .pastor img { display: block; width: 100%; max-width: 320px; height: auto; margin: 0 auto; border-radius: 16px; background: var(--surface-2); }
  .pastor-text { display: flex; flex-direction: column; }
  .pastor.has-photo .pastor-text { align-items: center; text-align: center; }
  .pastor strong { font-size: 1.25rem; letter-spacing: -0.03em; }
  .pastor-note { grid-column: 1 / -1; margin: 0; padding-top: 12px; border-top: 0.5px solid var(--line); font-size: .97rem; line-height: 1.75; }
  .pastor.has-photo .pastor-note { text-align: center; }
  .people li { display: flex; flex-direction: column; padding: 16px 18px; }
  .people li + li { border-top: 0.5px solid var(--line); }
  .people strong { font-size: 1.05rem; }
  .note { margin-top: 4px; font-size: .92rem; line-height: 1.7; }

  .meetings li { padding: 14px 0; border-bottom: 0.5px solid var(--line); }
  .meetings p { margin: 2px 0 0; font-size: .93rem; line-height: 1.6; }

  .welcome { margin-top: 32px; }
  .welcome p { margin: 4px 0 0; font-size: .94rem; line-height: 1.7; }

  .closing { margin: 56px 0 8px; text-align: center; }
  .closing-title { margin: 0 0 10px; font-size: .78rem; font-weight: 700; letter-spacing: .2em; color: var(--accent); }
  .closing-text { margin: 0 auto 16px; max-width: 22em; font-size: 1.2rem; font-weight: 700; line-height: 1.6; letter-spacing: -0.03em; }
  .closing-verse { margin: 0; font-size: .9rem; color: var(--muted); }
  .closing-verse cite { display: block; font-style: normal; font-size: .8rem; color: var(--faint); }
</style>
