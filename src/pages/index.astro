---
// 메인 페이지 — 하나님을사랑합니다 소개 + 공동체 목록
// 문구는 src/config.ts 의 MAIN 에서 바꿔요. 공동체는 src/communities/ 에 파일을 추가하면 자동으로 나타나요.
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND, MAIN } from '../config';
import { communities } from '../communities';
import { getSortedQt, formatDate } from '../lib/qt';

const cards = await Promise.all(
  communities.map(async (c) => ({ c, latest: (await getSortedQt(c.slug))[0] })),
);
---
<BaseLayout>
  <section class="hero">
    <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.2 0 3.7 1.2 5.3 3.1 1.6-1.9 3.1-3.1 5.3-3.1 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/>
    </svg>
    <h1>{BRAND}</h1>
    <p class="tagline">{MAIN.tagline}</p>
    <p class="muted">{MAIN.intro}</p>
  </section>

  <h2 class="section-title">공동체</h2>
  <ul class="list">
    {cards.map(({ c, latest }) => (
      <li>
        <a class="card community" href={`/${c.slug}`}>
          <span class="names">{c.parentNames}</span>
          <strong class="name">{c.mainName}</strong>
          <span class="muted tag">{c.tagline}</span>
          {latest && (
            <span class="latest">
              <span class="label">이번 주 큐티</span>
              {latest.data.title} · {latest.data.passage}
              <span class="date">{formatDate(latest.data.date)}</span>
            </span>
          )}
          <span class="go">들어가기 →</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .hero { text-align: center; padding: 28px 0 8px; }
  .mark { width: 44px; height: 44px; fill: var(--warm); }
  .hero h1 { margin: 10px 0 6px; font-size: 1.8rem; letter-spacing: -0.04em; }
  .tagline { margin: 0 0 12px; font-weight: 700; color: var(--accent); }
  .hero .muted { margin: 0 auto; max-width: 30em; font-size: .95rem; }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .community { display: flex; flex-direction: column; text-decoration: none; }
  .names { font-size: .72rem; font-weight: 700; letter-spacing: .14em; color: var(--muted); }
  .name { font-size: 1.5rem; font-weight: 800; letter-spacing: .02em; line-height: 1.3; }
  .tag { font-size: .92rem; }
  .latest {
    display: flex; flex-direction: column;
    margin-top: 14px; padding: 12px 14px;
    border-radius: 12px; background: var(--accent-soft);
    font-weight: 700; font-size: .95rem; line-height: 1.5;
  }
  .latest .label { font-size: .75rem; color: var(--accent); }
  .latest .date { font-size: .8rem; font-weight: 500; color: var(--muted); }
  .go { margin-top: 12px; font-weight: 700; font-size: .9rem; color: var(--accent); }
</style>
