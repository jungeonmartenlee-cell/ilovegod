---
// 메인 페이지 — 하나님을 사랑합니다 소개 + 공동체 목록
// 문구는 src/config.ts 의 MAIN 에서 바꿔요. 공동체는 src/communities/ 에 파일을 추가하면 자동으로 나타나요.
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND, MAIN } from '../config';
import { communities } from '../communities';
import { qrSvg, qrInitial } from '../lib/qr-art';

// 공동체를 누르면 뜨는 QR 팝업 — QR은 미리 만들어 둬요
const cards = communities.map((c) => {
  const url = new URL(`/${c.slug}`, Astro.site).href;
  const initial = qrInitial(c.slug);
  return { c, url, initial, qr: qrSvg(url, initial) };
});
---
<BaseLayout>
  <section class="hero">
    <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.2 0 3.7 1.2 5.3 3.1 1.6-1.9 3.1-3.1 5.3-3.1 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/>
    </svg>
    <h1>{BRAND}</h1>
    <p class="tagline">{MAIN.tagline}</p>
    <p class="muted intro">
      {MAIN.intro.map((line, i) => (
        <>{i === MAIN.intro.length - 1 && <br />}<span class="line">{line}</span>{' '}</>
      ))}
    </p>
  </section>

  <h2 class="section-title">공동체</h2>
  <ul class="list group">
    {cards.map(({ c }) => (
      <li>
        <a class="community" href={`/${c.slug}`} data-qr-open={c.slug}>
          <span class="top">
            <span class="name-wrap">
              <strong class="name">{c.mainName}</strong>
              <span class="names">{c.parentNames}</span>
            </span>
            <svg class="chev" viewBox="0 0 8 13" aria-hidden="true"><path d="M1.5 1.5 6.5 6.5 1.5 11.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          {c.tagline && (
            <span class="tag"><b>{c.tagline.split(' ')[0]}</b> {c.tagline.split(' ').slice(1).join(' ')}</span>
          )}

        </a>
      </li>
    ))}
  </ul>

  <dialog class="qr-sheet" data-qr-sheet aria-label="공동체 QR">
    <button type="button" class="close" data-qr-close aria-label="닫기"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
    {cards.map(({ c, url, initial, qr }) => (
      <div class="sheet-body" data-qr-for={c.slug} data-url={url} data-name={c.mainName} data-initial={initial} hidden>
        <p class="s-names">{c.parentNames}</p>
        <h2>{c.mainName}</h2>
        {c.tagline && <p class="s-tag">{c.tagline}</p>}
        <div class="s-qr" set:html={qr} />
        <p class="s-how">휴대폰 카메라로 찍으면 {c.mainName}에 바로 들어와요</p>
        <a class="btn s-go" href={`/${c.slug}`}>바로 이동하기</a>
        <button type="button" class="s-save" data-qr-save>QR 저장하기</button>
      </div>
    ))}
  </dialog>

  <div class="bottom-row">
    <a class="guide-link" href="/guide">교역자라면? 나눔지 1분 만들기</a>
    <a class="staff-btn" href="/staff">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4.5 20.5c.6-3.6 3.6-6 7.5-6s6.9 2.4 7.5 6" /></svg>
      교역자
    </a>
  </div>
</BaseLayout>

<script>
  import { saveQrPoster } from '../lib/qr-art';
  const sheet = document.querySelector<HTMLDialogElement>('[data-qr-sheet]')!;
  const bodies = sheet.querySelectorAll<HTMLElement>('[data-qr-for]');
  document.querySelectorAll<HTMLAnchorElement>('[data-qr-open]').forEach((a) => a.addEventListener('click', (e) => {
    if (!sheet.showModal || e.metaKey || e.ctrlKey || e.shiftKey) return;   // 팝업을 못 쓰면 그냥 이동해요
    e.preventDefault();
    bodies.forEach((b) => (b.hidden = b.dataset.qrFor !== a.dataset.qrOpen));
    sheet.showModal();
  }));
  const close = () => sheet.close();
  sheet.querySelector<HTMLElement>('[data-qr-close]')!.onclick = close;
  sheet.addEventListener('click', (e) => { if (e.target === sheet) close(); });   // 바깥을 누르면 닫혀요
  sheet.querySelectorAll<HTMLElement>('[data-qr-save]').forEach((b) => (b.onclick = () => {
    const d = (b.closest('[data-qr-for]') as HTMLElement).dataset;
    saveQrPoster(d.url!, d.name!, d.initial!);
  }));
</script>

<style>
  .qr-sheet {
    width: min(92vw, 380px); max-height: 92dvh; margin: auto; padding: 0;
    border: 0; border-radius: 28px; background: var(--card); color: var(--text);
    box-shadow: 0 30px 80px rgba(0, 0, 0, .25);
  }
  .qr-sheet::backdrop { background: rgba(0, 0, 0, .45); backdrop-filter: blur(6px); }
  .qr-sheet[open] { animation: pop .28s cubic-bezier(.2, .8, .2, 1); }
  @keyframes pop { from { opacity: 0; transform: translateY(16px) scale(.97); } }
  .close { position: absolute; top: 12px; right: 12px; width: 36px; height: 36px; display: grid; place-items: center; border: 0; border-radius: 50%; background: var(--surface-2); cursor: pointer; }
  .close svg { width: 16px; height: 16px; stroke: var(--muted); stroke-width: 2.4; stroke-linecap: round; fill: none; }
  .sheet-body { display: grid; justify-items: center; padding: 34px 24px 22px; text-align: center; }
  .sheet-body[hidden] { display: none; }
  .s-names { margin: 0 0 4px; font-size: .66rem; font-weight: 600; letter-spacing: .16em; color: var(--faint); }
  .sheet-body h2 { margin: 0; font-size: 1.9rem; font-weight: 800; letter-spacing: -0.02em; }
  .s-tag { margin: 4px 0 0; font-size: .92rem; color: var(--accent); font-weight: 600; }
  .s-qr { width: min(62vw, 220px); margin: 20px 0 12px; padding: 12px; background: #fff; border-radius: 18px; }
  .s-qr :global(svg) { display: block; width: 100%; height: auto; }
  .s-how { margin: 0 0 18px; font-size: .85rem; color: var(--muted); }
  .s-go { width: 100%; }
  .s-save { margin-top: 10px; padding: 8px 12px; border: 0; background: none; font: inherit; font-size: .9rem; font-weight: 600; color: var(--muted); cursor: pointer; }

  .hero { text-align: center; padding: 40px 0 8px; }
  .mark { width: 40px; height: 40px; fill: var(--heart); }
  .hero h1 { margin: 12px 0 6px; font-size: 2.2rem; letter-spacing: -0.05em; word-spacing: .14em; }
  .tagline { margin: 0 0 12px; font-size: 1.05rem; font-weight: 600; color: var(--muted); }
  .intro { margin: 0 auto; max-width: 26em; font-size: .95rem; line-height: 1.7; }
  .intro .line { display: inline-block; }

  .list { list-style: none; margin: 0; padding: 0; }
  .list li + li .community { border-top: 0.5px solid var(--line); }
  .community { display: flex; flex-direction: column; padding: 20px 22px; text-decoration: none; }
  .community:active { background: var(--surface-2); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .name-wrap { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .name { font-size: 1.7rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; }
  .names { font-size: .68rem; font-weight: 600; letter-spacing: .16em; color: var(--faint); }
  .tag { margin-top: 2px; font-size: .95rem; color: var(--muted); }
  .tag b { font-weight: 700; color: var(--accent); }
  .latest { display: flex; flex-direction: column; margin-top: 16px; padding-top: 14px; border-top: 0.5px solid var(--line); line-height: 1.45; }
  .label { font-size: .75rem; font-weight: 700; color: var(--accent); }
  .gbs { margin-top: 2px; font-weight: 600; }
  .date { font-size: .82rem; color: var(--faint); }
  .bottom-row { display: flex; align-items: center; justify-content: flex-end; gap: 12px; margin-top: 56px; }
  .guide-link { margin-right: auto; font-size: .85rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  .legal { margin: 0; font-size: .72rem; color: var(--faint); opacity: .8; }
  .legal a { color: inherit; text-decoration: none; }
  .legal span { margin: 0 6px; }
  .staff-btn {
    flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 10px 16px; border-radius: 999px;
    background: var(--glass-strong); -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur);
    border: 0.5px solid var(--line); box-shadow: 0 8px 24px rgba(0, 0, 0, .1);
    font-size: .88rem; font-weight: 700; color: var(--text); text-decoration: none;
  }
  .staff-btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
</style>
