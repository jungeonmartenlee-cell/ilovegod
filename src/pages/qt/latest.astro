---
// QR코드용 고정 주소: /qt/latest
// 사이트를 다시 만들 때마다 가장 최신 큐티로 자동 연결됩니다.
import { getSortedQt } from '../../lib/qt';

const [latest] = await getSortedQt();
const target = latest ? `/qt/${latest.id}` : '/qt';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>이번 주 큐티로 이동 중…</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
  </head>
  <body style="font-family:sans-serif;padding:24px">
    <p>이번 주 큐티로 이동 중이에요… <a href={target}>바로 가기</a></p>
  </body>
</html>
